{
  "compilerOptions": {
    "target": "ES2020",
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "noEmit": true
  },
  "include": ["vite.config.ts", "vitest.config.ts", "electron", "tests", "src/types.ts", "src/utils/entries.ts", "e2e", "playwright.config.ts"]
}
