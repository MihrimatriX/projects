{
  "name": "e-posta-istemcisi-ve-takip-araci",
  "version": "1.3.0",
  "description": "Yerel IMAP/SMTP e-posta istemcisi — takip paneli, snooze, şablonlar",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.js",
  "author": "MihrimatriX",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "npm run build && electron .",
    "test": "vitest run",
    "preview": "vite preview",
    "pack": "npm run build && electron-builder --win",
    "pack:mac": "npm run build && electron-builder --mac",
    "pack:linux": "npm run build && electron-builder --linux",
    "icons": "python scripts/generate_icon.py",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.14.13",
    "better-sqlite3": "^13.0.3",
    "imapflow": "^2.2.5",
    "mailparser": "^3.9.36",
    "nodemailer": "^10.0.15",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/mailparser": "^3.9.0",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "rcedit": "^5.0.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vite-plugin-electron": "^1.1.2",
    "vite-plugin-electron-renderer": "^1.0.0",
    "vitest": "^5.0.3"
  },
  "build": {
    "appId": "com.eposta.istemcisi",
    "productName": "E-posta İstemcisi",
    "icon": "build/icon.png",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "!node_modules/**/*",
      "node_modules/better-sqlite3/{package.json,LICENSE,lib/**,prebuilds/win32-*.node}"
    ],
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "signAndEditExecutable": false,
      "icon": "build/icon.ico"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "executableName": "EpostaIstemcisi",
    "npmRebuild": false
  },
  "allowScripts": {
    "electron": true,
    "esbuild": true,
    "electron-winstaller": false,
    "better-sqlite3": false
  }
}
