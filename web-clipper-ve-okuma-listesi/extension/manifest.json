{
  "manifest_version": 3,
  "name": "Kayıtlı Okuma",
  "description": "Sayfaları kaydedin ve okuma listesinde okuyun. Veriler eklenti içinde saklanır — sunucu gerekmez.",
  "version": "2.0.0",
  "permissions": ["activeTab", "storage", "unlimitedStorage", "scripting", "sidePanel"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Sayfayı kaydet",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
