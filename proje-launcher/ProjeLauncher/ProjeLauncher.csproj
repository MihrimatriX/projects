<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RollForward>Major</RollForward>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>DevProjects</AssemblyName>
    <RootNamespace>ProjeLauncher</RootNamespace>
    <Version>2.0.0</Version>
    <Product>Proje Launcher</Product>
    <AssemblyTitle>DEV Projects</AssemblyTitle>
    <Description>DEV Projects monorepo uygulama galerisi</Description>
    <!-- WPF0001: ThemeMode (Fluent) API'si .NET 9/10'da deneysel isaretli. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ProjeLauncher.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

</Project>
