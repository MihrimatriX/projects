<Window x:Class="ProjeLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ProjeLauncher.ViewModels"
        xmlns:models="clr-namespace:ProjeLauncher.Models"
        x:Name="Root"
        Title="DEV Projects"
        AutomationProperties.AutomationId="MainWindow"
        Height="820" Width="1280" MinHeight="520" MinWidth="720"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <!-- Galeri karti kabi: secim/odak/hover gorselleri -->
        <Style x:Key="CardContainer" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
            <Setter Property="AutomationProperties.AutomationId" Value="{Binding Folder, StringFormat=card-{0}}" />
            <Setter Property="AutomationProperties.HelpText" Value="{Binding Description}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid Margin="6">
                            <Border x:Name="Card" CornerRadius="8" BorderThickness="1"
                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                                <ContentPresenter />
                            </Border>
                            <Border x:Name="Ring" CornerRadius="9" Margin="-2" BorderThickness="2"
                                    BorderBrush="{DynamicResource AccentFillColorDefaultBrush}" Visibility="Collapsed" IsHitTestVisible="False" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="{DynamicResource CardBackgroundFillColorSecondaryBrush}" />
                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
                                <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Kucuk ikon dugmesi (kart ustu) -->
        <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="6" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
        </Style>

        <Style x:Key="ActionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="ContentTemplate" Value="{StaticResource IconText}" />
        </Style>

        <DataTemplate x:Key="CardTemplate" DataType="{x:Type models:ProjectEntry}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Gorsel: yer tutucu (yigin rengi + bas harfler) ve ustunde ekran goruntusu -->
                <Grid Height="{Binding CardImageHeight, ElementName=Root}">
                    <Border CornerRadius="7,7,0,0" Background="{Binding StackColor, Converter={StaticResource HexToBrush}, ConverterParameter=gradient}">
                        <TextBlock Text="{Binding Initials}" Foreground="#F2FFFFFF" FontSize="34" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <Border CornerRadius="7,7,0,0" Visibility="{Binding Thumbnail, Converter={StaticResource NullToVis}}">
                        <Border.Background>
                            <ImageBrush ImageSource="{Binding Thumbnail}" Stretch="UniformToFill" AlignmentY="Top" />
                        </Border.Background>
                    </Border>
                    <Border CornerRadius="10" Padding="8,2" Margin="8" HorizontalAlignment="Left" VerticalAlignment="Top"
                            Background="{DynamicResource SystemFillColorSuccessBrush}"
                            Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Çalışıyor" FontSize="11" FontWeight="SemiBold" Foreground="White" />
                    </Border>
                    <Button Style="{StaticResource IconButton}" Margin="6" HorizontalAlignment="Right" VerticalAlignment="Top"
                            Command="{Binding DataContext.ToggleFavoriteCommand, ElementName=Root}" CommandParameter="{Binding}"
                            AutomationProperties.Name="{Binding Name, StringFormat='Favori: {0}'}" ToolTip="Favorilere ekle/çıkar">
                        <TextBlock>
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Glyph}">
                                    <Setter Property="Text" Value="&#xE734;" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                            <Setter Property="Text" Value="&#xE735;" />
                                            <Setter Property="Foreground" Value="#FFE3A21A" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Button>
                </Grid>

                <StackPanel Grid.Row="1" Margin="14,10,10,10">
                    <TextBlock Text="{Binding Name}" Style="{DynamicResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                               ToolTip="{Binding Name}" />
                    <TextBlock Text="{Binding Description}" Style="{StaticResource Muted}" Margin="0,2,4,8" ToolTip="{Binding Description}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" ClipToBounds="True">
                            <Border Style="{StaticResource Pill}">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="8" Height="8" Fill="{Binding StackColor, Converter={StaticResource HexToBrush}}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding StackLabel}" FontSize="11" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Pill}" Margin="6,0,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="{DynamicResource TextFillColorDisabledBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasExe}" Value="True">
                                                        <Setter Property="Fill" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock Text="{Binding ExeStatus}" FontSize="11" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                            <Button Style="{StaticResource IconButton}" Margin="0,0,4,0"
                                    Command="{Binding DataContext.OpenDetailCommand, ElementName=Root}" CommandParameter="{Binding}"
                                    AutomationProperties.Name="{Binding Name, StringFormat='Ayrıntılar: {0}'}" ToolTip="Ayrıntılar (Enter / çift tık)">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE946;" FontSize="14" />
                            </Button>
                            <Button Style="{StaticResource IconButton}" IsEnabled="{Binding CanLaunch}"
                                    Command="{Binding DataContext.OpenCommand, ElementName=Root}" CommandParameter="{Binding}"
                                    AutomationProperties.Name="{Binding Name, StringFormat='Aç: {0}'}" ToolTip="Aç (Ctrl+Enter)">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE768;" FontSize="14" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="248" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Kenar cubugu -->
        <DockPanel Margin="12,16,8,12">
            <StackPanel DockPanel.Dock="Top" Margin="8,0,0,16">
                <TextBlock Text="DEV Projects" Style="{DynamicResource SubtitleTextBlockStyle}" />
                <TextBlock Text="Monorepo uygulama galerisi" Style="{StaticResource Muted}" />
            </StackPanel>

            <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Padding="32,6,8,6"
                         AutomationProperties.AutomationId="SearchBox" AutomationProperties.Name="Ara"
                         AutomationProperties.HelpText="Ad, açıklama, etiket veya klasörde ara (Ctrl+F)" ToolTip="Ara (Ctrl+F)" />
                <TextBlock Style="{StaticResource Glyph}" Text="&#xE721;" FontSize="14" Margin="10,0,0,0" HorizontalAlignment="Left"
                           IsHitTestVisible="False" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <TextBlock Text="Ara (Ctrl+F)" Margin="33,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           Visibility="{Binding SearchText, Converter={StaticResource NullToVis}, ConverterParameter=invert}" />
            </Grid>

            <Button DockPanel.Dock="Bottom" Content="Yenile (F5)" Tag="&#xE72C;" ContentTemplate="{StaticResource IconText}"
                    HorizontalAlignment="Stretch" Margin="0,8,0,0" Command="{Binding RefreshCommand}"
                    AutomationProperties.AutomationId="RefreshButton" AutomationProperties.Name="Yenile" />

            <ListBox x:Name="NavList" ItemsSource="{Binding NavItems}" SelectedItem="{Binding SelectedNav}"
                     Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     AutomationProperties.AutomationId="NavList" AutomationProperties.Name="Kategoriler ve filtreler">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                        <Setter Property="AutomationProperties.Name" Value="{Binding Label}" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsHeader}" Value="True">
                                <Setter Property="IsEnabled" Value="False" />
                                <Setter Property="Focusable" Value="False" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:NavItem}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Glyph}" Text="{Binding Glyph}" FontSize="14" Margin="0,0,12,0" />
                            <Ellipse Width="10" Height="10" Margin="2,0,14,0" VerticalAlignment="Center"
                                     Fill="{Binding Color, Converter={StaticResource HexToBrush}}"
                                     Visibility="{Binding Color, Converter={StaticResource NullToVis}}" />
                            <TextBlock Grid.Column="1" Text="{Binding Label}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsHeader}" Value="True">
                                                <Setter Property="FontSize" Value="11" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                <Setter Property="Margin" Value="0,10,0,0" />
                                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Grid.Column="2" Text="{Binding Count}" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="8,0,0,0"
                                       Visibility="{Binding IsHeader, Converter={StaticResource NullToVis}, ConverterParameter=invert}" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- Icerik alani -->
        <Border Grid.Column="1" CornerRadius="8,0,0,0" BorderThickness="1,1,0,0"
                Background="{DynamicResource LayerFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <Grid>
                <!-- Galeri -->
                <DockPanel x:Name="GalleryView" Visibility="{Binding DetailProject, Converter={StaticResource NullToVis}, ConverterParameter=invert}">
                    <Grid DockPanel.Dock="Top" Margin="28,20,28,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding SelectedNav.Label}" Style="{DynamicResource TitleTextBlockStyle}" TextTrimming="CharacterEllipsis"
                                       AutomationProperties.AutomationId="GalleryTitle" />
                            <TextBlock Text="{Binding ResultText}" Style="{StaticResource Muted}" AutomationProperties.AutomationId="ResultText" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                                    AutomationProperties.Name="Exe filtresi">
                            <RadioButton Content="Hepsi" GroupName="Exe" Margin="0,0,4,0" MinWidth="0" AutomationProperties.AutomationId="ExeAll"
                                         IsChecked="{Binding ExeFilter, Converter={StaticResource EnumEquals}, ConverterParameter=All}" />
                            <RadioButton Content="Exe var" GroupName="Exe" Margin="0,0,4,0" MinWidth="0" AutomationProperties.AutomationId="ExeHas"
                                         IsChecked="{Binding ExeFilter, Converter={StaticResource EnumEquals}, ConverterParameter=HasExe}" />
                            <RadioButton Content="Exe yok" GroupName="Exe" MinWidth="0" AutomationProperties.AutomationId="ExeNo"
                                         IsChecked="{Binding ExeFilter, Converter={StaticResource EnumEquals}, ConverterParameter=NoExe}" />
                        </StackPanel>
                    </Grid>

                    <Grid>
                        <ListBox x:Name="ProjectGrid" ItemsSource="{Binding Projects}" SelectedItem="{Binding SelectedProject}"
                                 ItemContainerStyle="{StaticResource CardContainer}" ItemTemplate="{StaticResource CardTemplate}"
                                 Background="Transparent" BorderThickness="0" Padding="22,4,22,16"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="False"
                                 KeyboardNavigation.DirectionalNavigation="Contained"
                                 SizeChanged="ProjectGrid_SizeChanged" MouseDoubleClick="ProjectGrid_MouseDoubleClick"
                                 AutomationProperties.AutomationId="ProjectGrid" AutomationProperties.Name="Projeler">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel ItemWidth="{Binding CardWidth, ElementName=Root}" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                        </ListBox>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding Projects.Count}" Value="0" />
                                                <Condition Binding="{Binding IsLoading}" Value="False" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE721;" FontSize="40" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            <TextBlock Text="Eşleşen proje yok" AutomationProperties.AutomationId="EmptyState" Style="{DynamicResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" Margin="0,12,0,4" />
                            <TextBlock Text="Aramayı veya filtreleri temizlemek için Esc'e basın." Style="{StaticResource Muted}" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </DockPanel>

                <!-- Detay -->
                <ScrollViewer x:Name="DetailView" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Visibility="{Binding DetailProject, Converter={StaticResource NullToVis}}"
                              AutomationProperties.AutomationId="DetailView" AutomationProperties.Name="Proje ayrıntıları">
                    <StackPanel DataContext="{Binding DetailProject}" Margin="28,16,28,28" MaxWidth="1100">
                        <Button x:Name="BackButton" Content="Galeri" Tag="&#xE72B;" ContentTemplate="{StaticResource IconText}"
                                HorizontalAlignment="Left" Margin="0,0,0,16" Padding="10,5"
                                Command="{Binding DataContext.CloseDetailCommand, ElementName=Root}"
                                AutomationProperties.AutomationId="BackButton" AutomationProperties.Name="Galeriye dön" ToolTip="Galeriye dön (Esc)" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" Style="{DynamicResource TitleTextBlockStyle}" TextWrapping="Wrap"
                                           AutomationProperties.AutomationId="DetailTitle" />
                                <WrapPanel Margin="0,8,0,0">
                                    <Border Style="{StaticResource Pill}" Margin="0,0,6,4">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="8" Height="8" Fill="{Binding StackColor, Converter={StaticResource HexToBrush}}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding StackLabel}" FontSize="12" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource Pill}" Margin="0,0,6,4" Visibility="{Binding Category, Converter={StaticResource NullToVis}}">
                                        <TextBlock Text="{Binding Category}" FontSize="12" />
                                    </Border>
                                    <Border Style="{StaticResource Pill}" Margin="0,0,6,4">
                                        <TextBlock Text="{Binding ExeStatus}" FontSize="12" />
                                    </Border>
                                    <Border Style="{StaticResource Pill}" Margin="0,0,6,4" Background="{DynamicResource SystemFillColorSuccessBackgroundBrush}"
                                            Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="Çalışıyor" FontSize="12" Foreground="{DynamicResource SystemFillColorSuccessBrush}" />
                                    </Border>
                                </WrapPanel>
                            </StackPanel>
                            <Button Grid.Column="1" VerticalAlignment="Top" Tag="&#xE734;" ContentTemplate="{StaticResource IconText}"
                                    Command="{Binding DataContext.ToggleFavoriteCommand, ElementName=Root}"
                                    AutomationProperties.AutomationId="FavoriteButton">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                        <Setter Property="Content" Value="Favorilere ekle" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                <Setter Property="Content" Value="Favorilerden çıkar" />
                                                <Setter Property="Tag" Value="&#xE735;" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>

                        <WrapPanel Margin="0,16,0,8">
                            <Button Style="{DynamicResource AccentButtonStyle}" Content="Aç" Tag="&#xE768;" ContentTemplate="{StaticResource IconText}"
                                    Margin="0,0,8,8" Padding="16,6" IsEnabled="{Binding CanLaunch}"
                                    Command="{Binding DataContext.OpenCommand, ElementName=Root}"
                                    AutomationProperties.AutomationId="OpenButton" ToolTip="Exe varsa exe'yi, yoksa kaynaktan çalıştırır (Ctrl+Enter)" />
                            <Button Style="{StaticResource ActionButton}" Content="Kaynaktan çalıştır" Tag="&#xE943;" IsEnabled="{Binding HasRunScript}"
                                    Command="{Binding DataContext.RunSourceCommand, ElementName=Root}"
                                    AutomationProperties.AutomationId="SourceButton" ToolTip="launcher.ps1 -Exec (yeni konsol)" />
                            <Button Style="{StaticResource ActionButton}" Content="Exe üret" Tag="&#xE7B8;" IsEnabled="{Binding HasPublish}"
                                    Command="{Binding DataContext.PublishCommand, ElementName=Root}"
                                    AutomationProperties.AutomationId="PublishButton" ToolTip="launcher.ps1 -Publish (yeni konsol)" />
                            <Button Style="{StaticResource ActionButton}" Content="Testleri çalıştır" Tag="&#xE9D5;" IsEnabled="{Binding HasRunScript}"
                                    Command="{Binding DataContext.RunTestsCommand, ElementName=Root}"
                                    AutomationProperties.AutomationId="TestsButton" ToolTip="run.ps1 -Check (yeni konsol)" />
                            <Button Style="{StaticResource ActionButton}" Content="Klasörü aç" Tag="&#xE838;"
                                    Command="{Binding DataContext.OpenFolderCommand, ElementName=Root}"
                                    AutomationProperties.AutomationId="FolderButton" />
                            <Button Style="{StaticResource ActionButton}" Content="README aç" Tag="&#xE8A5;"
                                    Command="{Binding DataContext.OpenReadmeCommand, ElementName=Root}"
                                    AutomationProperties.AutomationId="ReadmeButton" />
                        </WrapPanel>

                        <!-- Buyuk ekran goruntusu -->
                        <Border CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" ClipToBounds="True"
                                MinHeight="200" MaxHeight="460">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource SolidBackgroundFillColorBaseBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DataContext.DetailImage, ElementName=Root}" Value="{x:Null}">
                                            <Setter Property="Background" Value="{Binding StackColor, Converter={StaticResource HexToBrush}, ConverterParameter=gradient}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <TextBlock Text="{Binding Initials}" Foreground="#F2FFFFFF" FontSize="72" FontWeight="SemiBold" Margin="0,40"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Visibility="{Binding DataContext.DetailImage, ElementName=Root, Converter={StaticResource NullToVis}, ConverterParameter=invert}" />
                                <Image Source="{Binding DataContext.DetailImage, ElementName=Root}" Stretch="Uniform" StretchDirection="DownOnly"
                                       AutomationProperties.Name="{Binding Name, StringFormat='{}{0} ekran görüntüsü'}"
                                       AutomationProperties.AutomationId="DetailImage" />
                            </Grid>
                        </Border>
                        <TextBlock Text="Ekran görüntüsü yok — publish sonrası docs\ekran.png eklenince burada görünür."
                                   Style="{StaticResource Muted}" Margin="0,6,0,0" TextWrapping="Wrap"
                                   Visibility="{Binding DataContext.SelectedShot, ElementName=Root, Converter={StaticResource NullToVis}, ConverterParameter=invert}" />

                        <ListBox ItemsSource="{Binding DataContext.DetailShots, ElementName=Root}" SelectedItem="{Binding DataContext.SelectedShot, ElementName=Root}"
                                 Background="Transparent" BorderThickness="0" Margin="0,8,0,0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                 AutomationProperties.AutomationId="ShotList" AutomationProperties.Name="Ekran görüntüleri">
                            <ListBox.Style>
                                <Style TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DataContext.DetailShots.Count, ElementName=Root}" Value="1">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding DataContext.DetailShots.Count, ElementName=Root}" Value="0">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.Style>
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                    <Setter Property="AutomationProperties.Name" Value="{Binding Label}" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:ScreenshotItem}">
                                    <Border Width="144" Height="90" CornerRadius="4" BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                            ToolTip="{Binding Label}">
                                        <Border.Background>
                                            <ImageBrush ImageSource="{Binding Thumb}" Stretch="UniformToFill" AlignmentY="Top" />
                                        </Border.Background>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Grid Margin="0,20,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" MinWidth="200" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Hakkında" Style="{DynamicResource SubtitleTextBlockStyle}" FontSize="16" Margin="0,0,0,8" />
                                <TextBlock Text="{Binding Description}" TextWrapping="Wrap" AutomationProperties.AutomationId="DetailDescription" />
                                <TextBlock Text="{Binding DataContext.DetailReadme.Intro, ElementName=Root}" TextWrapping="Wrap" Margin="0,8,0,0"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Visibility="{Binding DataContext.DetailReadme.Intro, ElementName=Root, Converter={StaticResource NullToVis}}" />
                                <TextBlock Text="Özellikler" Style="{DynamicResource BodyStrongTextBlockStyle}" Margin="0,16,0,6"
                                           Visibility="{Binding DataContext.DetailReadme.Features.Count, ElementName=Root, Converter={StaticResource NullToVis}}" />
                                <ItemsControl ItemsSource="{Binding DataContext.DetailReadme.Features, ElementName=Root}" AutomationProperties.AutomationId="FeatureList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="16" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="•" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                                <TextBlock Grid.Column="1" Text="{Binding}" TextWrapping="Wrap" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Bilgiler" Style="{DynamicResource SubtitleTextBlockStyle}" FontSize="16" Margin="0,0,0,8" />
                                <TextBlock Text="Klasör" Style="{StaticResource Muted}" />
                                <TextBlock Text="{Binding Folder}" TextWrapping="Wrap" Margin="0,0,0,10" FontFamily="Cascadia Mono, Consolas" FontSize="12" />
                                <TextBlock Text="Exe" Style="{StaticResource Muted}" />
                                <TextBlock Text="{Binding ExeRelative}" TextWrapping="Wrap" Margin="0,0,0,10" FontFamily="Cascadia Mono, Consolas" FontSize="12" />
                                <TextBlock Text="Etiketler" Style="{StaticResource Muted}" Visibility="{Binding TagsText, Converter={StaticResource NullToVis}}" />
                                <ItemsControl ItemsSource="{Binding Tags}" AutomationProperties.AutomationId="TagList">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource Pill}" Margin="0,4,6,0">
                                                <TextBlock Text="{Binding}" FontSize="12" />
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <ProgressBar IsIndeterminate="True" VerticalAlignment="Top" Height="3" Margin="8,0"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" AutomationProperties.Name="Yükleniyor" />
            </Grid>
        </Border>

        <!-- Durum cubugu -->
        <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="16,6,16,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Muted}" VerticalAlignment="Center"
                       AutomationProperties.AutomationId="StatusText" AutomationProperties.LiveSetting="Polite" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource Glyph}" Text="&#xE768;" FontSize="12" Margin="0,0,6,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <TextBlock Text="{Binding RunningText}" Style="{StaticResource Muted}" AutomationProperties.AutomationId="RunningText" />
            </StackPanel>
            <ItemsControl Grid.Column="2" ItemsSource="{Binding Toolchains}" VerticalAlignment="Center"
                          AutomationProperties.AutomationId="Toolchains" AutomationProperties.Name="Araç zinciri">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="12,0,0,0" Background="Transparent"
                                    ToolTip="{Binding Hint}" AutomationProperties.Name="{Binding Label}">
                            <Ellipse Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Ok}" Value="True">
                                                <Setter Property="Fill" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding Name}" Style="{StaticResource Muted}" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </Grid>
</Window>
