datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model Board {
  id        String   @id @default(uuid())
  name      String
  data      String   // JSON-serialized tldraw document store snapshot
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
