{
  "name": "gorsel-not-desktop",
  "productName": "Gorsel Not",
  "version": "0.2.0",
  "description": "Gorsel Not ve Beyin Haritasi - masaustu kabugu",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win dir"
  },
  "devDependencies": {
    "electron": "^42.11.10",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "local.gorsel-not",
    "productName": "Gorsel Not",
    "executableName": "GorselNot",
    "electronLanguages": ["tr", "en-US"],
    "directories": { "output": "out" },
    "files": ["main.cjs", "package.json"],
    "win": { "target": "dir", "icon": "../assets/icon-256.png" },
    "npmRebuild": false
  },
  "allowScripts": {
    "electron": true,
    "electron-winstaller": false
  }
}
