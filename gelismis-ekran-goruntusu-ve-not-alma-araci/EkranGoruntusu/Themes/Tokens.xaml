<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- design/css/tokens.css -->
    <Color x:Key="BgAppColor">#FF111111</Color>
    <Color x:Key="BgToolbarColor">#FF1C1C1E</Color>
    <Color x:Key="BgPanelColor">#FF252528</Color>
    <Color x:Key="BgCanvasColor">#FF2C2C2E</Color>
    <Color x:Key="BgHoverColor">#FF323236</Color>
    <Color x:Key="ShellColor">#FF0A0A0A</Color>
    <Color x:Key="AccentColor">#FF0EA5E9</Color>
    <Color x:Key="AccentHoverColor">#FF0284C7</Color>
    <Color x:Key="TextPrimaryColor">#FFFAFAFA</Color>
    <Color x:Key="TextSecondaryColor">#FFA1A1AA</Color>
    <Color x:Key="TextMutedColor">#FF71717A</Color>
    <Color x:Key="BorderColor">#FF3A3A3E</Color>
    <Color x:Key="DangerColor">#FFEF4444</Color>
    <Color x:Key="SuccessColor">#FF22C55E</Color>
    <Color x:Key="WarningColor">#FFF59E0B</Color>
    <Color x:Key="SelectionFillColor">#260EA5E9</Color>

    <SolidColorBrush x:Key="BgAppBrush" Color="{StaticResource BgAppColor}" />
    <SolidColorBrush x:Key="BgToolbarBrush" Color="{StaticResource BgToolbarColor}" />
    <SolidColorBrush x:Key="BgPanelBrush" Color="{StaticResource BgPanelColor}" />
    <SolidColorBrush x:Key="BgCanvasBrush" Color="{StaticResource BgCanvasColor}" />
    <SolidColorBrush x:Key="BgHoverBrush" Color="{StaticResource BgHoverColor}" />
    <SolidColorBrush x:Key="ShellBrush" Color="{StaticResource ShellColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="SelectionFillBrush" Color="{StaticResource SelectionFillColor}" />
</ResourceDictionary>
