<Window x:Class="EkranGoruntusu.Views.EditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ekran Görüntüsü Düzenleyici"
        Height="680" Width="1000"
        MinHeight="480" MinWidth="760"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgAppBrush}"
        KeyDown="Window_KeyDown"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0" Background="{StaticResource BgToolbarBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="8,0">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Araçlar tek seçimli: RadioButton (UIA SelectionItem; eskiden "1".."5" yazan ToggleButton'lardı). -->
                    <RadioButton x:Name="BtnArrow" GroupName="Tool" Content="➚ Ok" ToolTip="Ok (1)" Style="{StaticResource ToolBtnStyle}" Checked="Tool_Checked" Tag="Arrow" IsChecked="True" />
                    <RadioButton x:Name="BtnRect" GroupName="Tool" Content="▭ Dikdörtgen" ToolTip="Dikdörtgen (2)" Style="{StaticResource ToolBtnStyle}" Checked="Tool_Checked" Tag="Rect" Margin="4,0,0,0" />
                    <RadioButton x:Name="BtnPen" GroupName="Tool" Content="✎ Kalem" ToolTip="Serbest çizim (3)" Style="{StaticResource ToolBtnStyle}" Checked="Tool_Checked" Tag="Pen" Margin="4,0,0,0" />
                    <RadioButton x:Name="BtnText" GroupName="Tool" Content="T Metin" ToolTip="Metin ekle (4)" Style="{StaticResource ToolBtnStyle}" Checked="Tool_Checked" Tag="Text" Margin="4,0,0,0" />
                    <RadioButton x:Name="BtnBlur" GroupName="Tool" Content="▦ Gizle" ToolTip="Bölgeyi pikselleştir (5)" Style="{StaticResource ToolBtnStyle}" Checked="Tool_Checked" Tag="Blur" Margin="4,0,0,0" />
                    <Rectangle Width="1" Height="24" Fill="{StaticResource BorderBrush}" Margin="10,0" />
                    <Button x:Name="BtnUndo" Content="↶" ToolTip="Geri al (Ctrl+Z)" Style="{StaticResource BtnGhost}" Width="36" Height="36" Padding="0"
                            AutomationProperties.Name="Geri al" Click="BtnUndo_Click" IsEnabled="False" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="EditorStatus" FontSize="11" Foreground="{StaticResource SuccessBrush}" VerticalAlignment="Center" Margin="0,0,12,0"
                               AutomationProperties.AutomationId="EditorStatus" />
                    <TextBlock x:Name="MetaLabel" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,12,0"
                               AutomationProperties.AutomationId="MetaLabel" />
                    <Button x:Name="BtnOcr" Content="OCR" Style="{StaticResource BtnGhost}" Click="BtnOcr_Click" Margin="0,0,8,0" MinHeight="32" Padding="12,6"
                            ToolTip="Görüntüdeki metni tanı (çevrimdışı)" />
                    <Button x:Name="BtnCopy" Content="Panoya kopyala" Style="{StaticResource BtnGhost}" Click="BtnCopy_Click" Margin="0,0,8,0" MinHeight="32"
                            ToolTip="İşaretlenmiş görüntüyü panoya kopyala (Ctrl+C)" />
                    <Button x:Name="BtnSave" Content="Kaydet" Style="{StaticResource BtnPrimary}" Click="BtnSave_Click" MinHeight="32"
                            ToolTip="PNG olarak kaydet, OCR uygula ve geçmişe ekle (Ctrl+S)" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="{StaticResource BgCanvasBrush}" Padding="24">
            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                <!-- Viewbox: pencereden büyük yakalamalar küçültülerek gösterilir. CanvasContainer kırpılmadığı için
                     RenderTargetBitmap hâlâ tam çözünürlükte (1 DIP = 1 piksel) kaydeder. -->
                <Viewbox StretchDirection="DownOnly">
                <Grid x:Name="CanvasContainer">
                    <Image x:Name="CroppedImage" Stretch="None" />
                    <InkCanvas x:Name="EditorInkCanvas" Background="Transparent" EditingMode="None"
                               MouseDown="InkCanvas_MouseDown" MouseMove="InkCanvas_MouseMove" MouseUp="InkCanvas_MouseUp" />
                </Grid>
                </Viewbox>
            </Border>
        </Border>

        <!-- OCR drawer -->
        <Border x:Name="OcrDrawer" Grid.Row="2" Background="{StaticResource BgToolbarBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border Background="Transparent" Padding="16,10" MouseLeftButtonUp="OcrHeader_Click" Cursor="Hand"
                        AutomationProperties.Name="OCR sonucu panelini aç/kapat">
                    <Grid>
                        <TextBlock Text="OCR SONUCU" FontSize="12" FontWeight="Medium" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                        <TextBlock x:Name="OcrToggleIcon" Text="▾" HorizontalAlignment="Right" Foreground="{StaticResource TextMutedBrush}" />
                    </Grid>
                </Border>
                <StackPanel x:Name="OcrBody" Grid.Row="1" Margin="16,0,16,14" Visibility="Collapsed">
                    <StackPanel x:Name="OcrLoadingPanel" Orientation="Horizontal" Visibility="Collapsed" Margin="0,0,0,8">
                        <TextBlock Text="Metin tanınıyor…" Foreground="{StaticResource WarningBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBox x:Name="OcrTextBox" IsReadOnly="True" AutomationProperties.Name="OCR sonucu" TextWrapping="Wrap" AcceptsReturn="True"
                             MinHeight="60" MaxHeight="100" VerticalScrollBarVisibility="Auto" Visibility="Collapsed" Margin="0,0,0,8" />
                    <TextBlock x:Name="OcrEmptyText" Text="Metin bulunamadı" FontStyle="Italic"
                               Foreground="{StaticResource TextMutedBrush}" Visibility="Collapsed" Margin="0,0,0,8" />
                    <Button Content="Panoya kopyala" Style="{StaticResource BtnPrimary}" HorizontalAlignment="Left"
                            Click="BtnCopyOcr_Click" Visibility="Collapsed" x:Name="BtnCopyOcr" MinHeight="32" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
