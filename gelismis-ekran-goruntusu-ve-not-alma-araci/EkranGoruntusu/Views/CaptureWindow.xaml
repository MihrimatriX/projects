<Window x:Class="EkranGoruntusu.Views.CaptureWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bölge Seçimi"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        Left="{x:Static SystemParameters.VirtualScreenLeft}"
        Top="{x:Static SystemParameters.VirtualScreenTop}"
        Width="{x:Static SystemParameters.VirtualScreenWidth}"
        Height="{x:Static SystemParameters.VirtualScreenHeight}"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Cursor="Cross"
        Loaded="Window_Loaded"
        KeyDown="Window_KeyDown"
        MouseRightButtonUp="Window_MouseRightButtonUp">

    <Window.Resources>
        <Style x:Key="ModeChipStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource BgHoverBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentBrush}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Image x:Name="BackgroundImage" Stretch="Fill" />

        <Rectangle Fill="#73000000" />

        <!-- Mode bar -->
        <Border HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,20,0,0"
                Background="{StaticResource BgToolbarBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                CornerRadius="8" Padding="4" Panel.ZIndex="20">
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="ModeRegion" GroupName="Mode" Content="Bölge" IsChecked="True" Checked="ModeRegion_Click" Focusable="False"
                             Style="{StaticResource ModeChipStyle}" ToolTip="Fareyle bir bölge seçin" />
                <RadioButton x:Name="ModeScreen" GroupName="Mode" Content="Tam ekran" Checked="ModeScreen_Click" Focusable="False"
                             Style="{StaticResource ModeChipStyle}" Margin="4,0,0,0" ToolTip="Tüm ekranı seç" />
                <Rectangle Width="1" Margin="8,4" Fill="{StaticResource BorderBrush}" />
                <Button x:Name="ConfirmButton" Content="Yakala" Click="Confirm_Click" Focusable="False" Style="{StaticResource BtnPrimary}"
                        ToolTip="Seçimi düzenleyicide aç (Enter)" />
                <Button x:Name="CancelButton" Content="İptal" Click="Cancel_Click" Focusable="False" Style="{StaticResource BtnGhost}"
                        Margin="4,0,0,0" ToolTip="Yakalamayı iptal et (Esc)" />
            </StackPanel>
        </Border>

        <Canvas x:Name="SelectionCanvas" Background="Transparent"
                MouseDown="Canvas_MouseDown" MouseMove="Canvas_MouseMove" MouseUp="Canvas_MouseUp">
            <Border x:Name="SelectionBorder" BorderBrush="{StaticResource AccentBrush}" BorderThickness="2"
                    Background="{StaticResource SelectionFillBrush}" Visibility="Collapsed">
                <TextBlock x:Name="SizeTag" VerticalAlignment="Bottom" Margin="0,0,0,-28"
                           Background="{StaticResource BgToolbarBrush}" Foreground="{StaticResource TextSecondaryBrush}"
                           FontFamily="Consolas" FontSize="11" Padding="8,3" />
            </Border>
        </Canvas>

        <!-- Hint bar -->
        <Border HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,24"
                Background="{StaticResource BgToolbarBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                CornerRadius="999" Padding="18,10" Panel.ZIndex="20">
            <StackPanel Orientation="Horizontal">
                <TextBlock FontSize="12" Foreground="{StaticResource TextMutedBrush}">
                    <Run Text="Enter" FontFamily="Consolas" /> onayla
                </TextBlock>
                <TextBlock Text="   ·   " Foreground="{StaticResource TextMutedBrush}" />
                <TextBlock FontSize="12" Foreground="{StaticResource TextMutedBrush}">
                    <Run Text="Esc" FontFamily="Consolas" /> iptal
                </TextBlock>
                <TextBlock Text="   ·   Sağ tık iptal" Foreground="{StaticResource TextMutedBrush}" FontSize="12" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
