<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="CanliDuvarKagidi_Shell.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:models="using:CanliDuvarKagidi_Shell.Models"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!-- Kisayollar: Ctrl+1..4 bolumler, Ctrl+F ara, Ctrl+O dosya ekle, F5 yenile, Ctrl+S ayarlari kaydet, Ctrl+P duraklat -->
    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Modifiers="Control" Key="Number1" Invoked="Accelerator_Invoked" />
        <KeyboardAccelerator Modifiers="Control" Key="Number2" Invoked="Accelerator_Invoked" />
        <KeyboardAccelerator Modifiers="Control" Key="Number3" Invoked="Accelerator_Invoked" />
        <KeyboardAccelerator Modifiers="Control" Key="Number4" Invoked="Accelerator_Invoked" />
        <KeyboardAccelerator Modifiers="Control" Key="F" Invoked="Accelerator_Invoked" />
        <KeyboardAccelerator Modifiers="Control" Key="O" Invoked="Accelerator_Invoked" />
        <KeyboardAccelerator Modifiers="Control" Key="S" Invoked="Accelerator_Invoked" />
        <KeyboardAccelerator Modifiers="Control" Key="P" Invoked="Accelerator_Invoked" />
        <KeyboardAccelerator Key="F5" Invoked="Accelerator_Invoked" />
    </Page.KeyboardAccelerators>

    <NavigationView
        x:Name="NavView"
        PaneDisplayMode="Left"
        IsBackButtonVisible="Collapsed"
        IsSettingsVisible="False"
        SelectionChanged="NavView_SelectionChanged"
        Background="Transparent">

        <NavigationView.PaneHeader>
            <StackPanel Margin="16,20,16,8" Spacing="4">
                <Border Width="40" Height="40" CornerRadius="10" HorizontalAlignment="Left" Background="{StaticResource BrandAccentGradient}">
                    <FontIcon Glyph="&#xE771;" FontSize="18" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="Canlı Duvar Kağıdı" FontWeight="SemiBold" FontSize="15" />
                <TextBlock Text="Motor" Opacity="0.55" FontSize="12" />
            </StackPanel>
        </NavigationView.PaneHeader>

        <NavigationView.MenuItems>
            <NavigationViewItem Content="Kütüphanem" Tag="installed" AutomationProperties.AutomationId="Nav_installed">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE8F1;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Mağaza" Tag="catalog" AutomationProperties.AutomationId="Nav_catalog">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE719;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Monitörler" Tag="monitors" AutomationProperties.AutomationId="Nav_monitors">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE7F4;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Ayarlar" Tag="settings" AutomationProperties.AutomationId="Nav_settings">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE713;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.MenuItems>

        <Grid Padding="32,24,32,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Page header -->
            <StackPanel x:Name="PageHeader" Grid.Row="0" Spacing="6" Margin="0,0,0,20">
                <TextBlock x:Name="PageTitle" AutomationProperties.AutomationId="PageTitle" AutomationProperties.HeadingLevel="Level1" Style="{StaticResource PageTitleStyle}" Text="Kütüphanem" />
                <TextBlock x:Name="PageSubtitle" Style="{StaticResource PageSubtitleStyle}"
                           Text="Kurulu duvar kağıtlarını yönetin ve monitöre uygulayın." />
            </StackPanel>

            <!-- Content area -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid>
                <!-- Installed -->
                <StackPanel x:Name="InstalledPanel" Spacing="16" Visibility="Visible"
                            AllowDrop="True" DragOver="InstalledPanel_DragOver" Drop="InstalledPanel_Drop">
                    <InfoBar x:Name="InstalledInfoBar" AutomationProperties.AutomationId="InstalledInfoBar" IsOpen="False" IsClosable="True" Severity="Informational" />

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource SectionLabelStyle}" Text="KURULU DUVAR KAĞITLARI" VerticalAlignment="Center" />
                            <Border Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="10" Padding="8,2">
                                <TextBlock x:Name="InstalledCountBadge" AutomationProperties.AutomationId="InstalledCount" Text="0" FontSize="12" Opacity="0.8" />
                            </Border>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <Button AutomationProperties.AutomationId="ImportButton" AutomationProperties.Name="Dosyadan ekle"
                                    Style="{StaticResource SubtleButtonStyle}" Click="ImportFile_Click"
                                    ToolTipService.ToolTip="Kendi görsel veya videonuzu ekleyin, sürükle-bırak da olur (Ctrl+O)">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE8E5;" FontSize="14" />
                                    <TextBlock Text="Dosyadan ekle" />
                                </StackPanel>
                            </Button>
                            <Button AutomationProperties.AutomationId="RefreshInstalledButton" AutomationProperties.Name="Yenile"
                                    ToolTipService.ToolTip="Kütüphaneyi yenile (F5)"
                                    Style="{StaticResource SubtleButtonStyle}" Click="RefreshInstalled_Click">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                                    <TextBlock Text="Yenile" />
                                </StackPanel>
                            </Button>
                            <Button AutomationProperties.AutomationId="ApplyInstalledButton" AutomationProperties.Name="Monitöre uygula"
                                    ToolTipService.ToolTip="Seçili duvar kağıdını birincil monitöre uygula (Enter ya da çift tıklama)"
                                    Style="{StaticResource BrandAccentButtonStyle}" Click="ApplyInstalled_Click">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE768;" FontSize="14" />
                                    <TextBlock Text="Monitöre uygula" />
                                </StackPanel>
                            </Button>
                            <Button AutomationProperties.AutomationId="UninstallButton" AutomationProperties.Name="Kaldır"
                                    ToolTipService.ToolTip="Seçili duvar kağıdını kütüphaneden kaldır (Delete)"
                                    Style="{StaticResource SubtleButtonStyle}" Click="Uninstall_Click">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE74D;" FontSize="14" />
                                    <TextBlock Text="Kaldır" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <TextBox x:Name="SearchBox" AutomationProperties.AutomationId="SearchBox"
                             AutomationProperties.Name="Kütüphanede ara" PlaceholderText="Ara: ad, tür veya açıklama (Ctrl+F)"
                             TextChanged="SearchBox_TextChanged" Width="420" HorizontalAlignment="Left" />

                    <GridView
                        x:Name="InstalledGrid"
                        AutomationProperties.AutomationId="InstalledGrid"
                        AutomationProperties.Name="Kurulu duvar kağıtları"
                        SelectionMode="Single"
                        IsItemClickEnabled="True"
                        ItemClick="InstalledGrid_ItemClick"
                        DoubleTapped="InstalledGrid_DoubleTapped"
                        PreviewKeyDown="InstalledGrid_KeyDown">
                        <GridView.ItemTemplate>
                            <DataTemplate x:DataType="models:WallpaperListItem">
                                <Border Style="{StaticResource WallpaperCardStyle}" Padding="16">
                                    <Grid RowDefinitions="*,Auto,Auto" RowSpacing="8">
                                        <FontIcon Glyph="{x:Bind Glyph}" FontSize="36" Opacity="0.85"
                                                  Foreground="{StaticResource BrandPrimaryBrush}" />
                                        <TextBlock Grid.Row="1" Text="{x:Bind Title}" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" TextWrapping="Wrap" MaxLines="2" />
                                        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
                                            <Border Style="{StaticResource TypeBadgeStyle}">
                                                <TextBlock Text="{x:Bind TypeLabel}" FontSize="11" />
                                            </Border>
                                            <TextBlock Text="{x:Bind Version}" FontSize="11" Opacity="0.5" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>

                    <StackPanel x:Name="InstalledEmpty" Visibility="Collapsed" Spacing="12" Padding="0,48">
                        <FontIcon Glyph="&#xE8F1;" FontSize="40" Opacity="0.35" HorizontalAlignment="Center" />
                        <TextBlock x:Name="InstalledEmptyTitle" AutomationProperties.AutomationId="InstalledEmptyTitle"
                                   Style="{StaticResource EmptyStateTitleStyle}" Text="Henüz duvar kağıdı yok" />
                        <TextBlock x:Name="InstalledEmptyBody" Style="{StaticResource EmptyStateBodyStyle}"
                                   Text="Mağaza sekmesinden duvar kağıdı indirin ya da kendi görsel/videonuzu buraya sürükleyin." />
                        <Button x:Name="GoToCatalogButton" AutomationProperties.AutomationId="GoToCatalogButton"
                                Style="{StaticResource BrandAccentButtonStyle}" HorizontalAlignment="Center"
                                Click="GoToCatalog_Click" Content="Mağazaya git" />
                    </StackPanel>
                </StackPanel>

                <!-- Catalog -->
                <StackPanel x:Name="CatalogPanel" Spacing="16" Visibility="Collapsed">
                    <InfoBar x:Name="CatalogInfoBar" AutomationProperties.AutomationId="CatalogInfoBar" IsOpen="False" IsClosable="True" Severity="Informational" />

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource SectionLabelStyle}" Text="KATALOG" VerticalAlignment="Center" />
                            <ProgressRing x:Name="CatalogLoadingRing" Width="16" Height="16" IsActive="False" Visibility="Collapsed" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <Button AutomationProperties.AutomationId="LoadCatalogButton" AutomationProperties.Name="Katalogu yükle"
                                    ToolTipService.ToolTip="Katalogu yeniden yükle (F5)"
                                    Style="{StaticResource SubtleButtonStyle}" Click="LoadCatalog_Click">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE896;" FontSize="14" />
                                    <TextBlock Text="Katalogu yükle" />
                                </StackPanel>
                            </Button>
                            <Button AutomationProperties.AutomationId="DownloadButton" AutomationProperties.Name="İndir ve kur"
                                    ToolTipService.ToolTip="Seçili duvar kağıdını indir ve kur (Enter ya da çift tıklama)"
                                    Style="{StaticResource BrandAccentButtonStyle}" Click="DownloadCatalogItem_Click">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE896;" FontSize="14" />
                                    <TextBlock Text="İndir ve kur" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <GridView
                        x:Name="CatalogGrid"
                        AutomationProperties.AutomationId="CatalogGrid"
                        AutomationProperties.Name="Katalog"
                        SelectionMode="Single"
                        IsItemClickEnabled="True"
                        ItemClick="CatalogGrid_ItemClick"
                        DoubleTapped="CatalogGrid_DoubleTapped"
                        PreviewKeyDown="CatalogGrid_KeyDown">
                        <GridView.ItemTemplate>
                            <DataTemplate x:DataType="models:CatalogListItem">
                                <Border Style="{StaticResource WallpaperCardStyle}" Padding="16">
                                    <Grid RowDefinitions="*,Auto,Auto,Auto" RowSpacing="6">
                                        <FontIcon Glyph="{x:Bind Glyph}" FontSize="36" Opacity="0.85"
                                                  Foreground="{StaticResource BrandSecondaryBrush}" />
                                        <TextBlock Grid.Row="1" Text="{x:Bind Title}" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" TextWrapping="Wrap" MaxLines="2" />
                                        <TextBlock Grid.Row="2" Text="{x:Bind Description}" FontSize="12" Opacity="0.6"
                                                   TextTrimming="CharacterEllipsis" TextWrapping="Wrap" MaxLines="2" />
                                        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8">
                                            <Border Style="{StaticResource TypeBadgeStyle}">
                                                <TextBlock Text="{x:Bind TypeLabel}" FontSize="11" />
                                            </Border>
                                            <TextBlock Text="{x:Bind Version}" FontSize="11" Opacity="0.5" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>

                    <StackPanel x:Name="CatalogEmpty" Visibility="Collapsed" Spacing="12" Padding="0,48">
                        <FontIcon Glyph="&#xE719;" FontSize="40" Opacity="0.35" HorizontalAlignment="Center" />
                        <TextBlock Style="{StaticResource EmptyStateTitleStyle}" Text="Katalog henüz yüklenmedi" />
                        <TextBlock Style="{StaticResource EmptyStateBodyStyle}"
                                   Text="Katalogu yükle butonuna tıklayarak self-host mağazanızdaki duvar kağıtlarını görüntüleyin." />
                        <Button AutomationProperties.AutomationId="LoadCatalogEmptyButton"
                                Style="{StaticResource BrandAccentButtonStyle}" HorizontalAlignment="Center"
                                Click="LoadCatalog_Click" Content="Katalogu yükle" />
                    </StackPanel>
                </StackPanel>

                <!-- Monitors -->
                <StackPanel x:Name="MonitorsPanel" Spacing="16" Visibility="Collapsed">
                    <InfoBar x:Name="MonitorInfoBar" AutomationProperties.AutomationId="MonitorInfoBar" IsOpen="False" IsClosable="True" Severity="Informational" />

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource SectionLabelStyle}" Text="AKTİF MONİTÖRLER" VerticalAlignment="Center" />
                        <ToggleSwitch x:Name="PauseAllSwitch" Grid.Column="1" AutomationProperties.AutomationId="PauseAllSwitch"
                                      AutomationProperties.Name="Tüm duvar kağıtlarını duraklat"
                                      ToolTipService.ToolTip="Tüm canlı duvar kağıtlarını duraklat ya da devam ettir (Ctrl+P, tepsi menüsünde de var)"
                                      OnContent="Duraklatıldı" OffContent="Oynatılıyor" Toggled="PauseAllSwitch_Toggled" />
                    </Grid>

                    <!-- GridView (secimsiz): her kart ekran okuyucuya ayri liste ogesi olarak duyurulur -->
                    <GridView x:Name="MonitorRepeater" AutomationProperties.AutomationId="MonitorRepeater"
                              AutomationProperties.Name="Aktif monitörler"
                              SelectionMode="None" IsItemClickEnabled="False">
                        <GridView.ItemTemplate>
                            <DataTemplate x:DataType="models:MonitorListItem">
                                <Border Style="{StaticResource MonitorCardStyle}" Width="320" MinHeight="96">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                                        <Border Width="48" Height="48" CornerRadius="10"
                                                Background="{StaticResource CardShimmerGradient}">
                                            <FontIcon Glyph="&#xE7F4;" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      Foreground="{StaticResource BrandPrimaryBrush}" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" />
                                                <Border CornerRadius="6" Padding="6,2"
                                                        Background="{ThemeResource SystemFillColorSuccessBrush}"
                                                        Visibility="{x:Bind ActiveBadgeVisibility}">
                                                    <TextBlock Text="Aktif" FontSize="10" Foreground="White" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{x:Bind Resolution}" FontSize="12" Opacity="0.6" />
                                            <TextBlock Text="{x:Bind WallpaperDisplay}" FontSize="12" Opacity="0.85" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>

                    <Border Style="{StaticResource SurfaceCardStyle}" Margin="0,8,0,0">
                        <StackPanel Spacing="16">
                            <TextBlock Text="Monitöre ata" FontWeight="SemiBold" />
                            <Grid ColumnSpacing="12" RowSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="MonitorPicker" AutomationProperties.AutomationId="MonitorPicker" Header="Monitör" PlaceholderText="Monitör seç" HorizontalAlignment="Stretch" />
                                <ComboBox x:Name="WallpaperPicker" AutomationProperties.AutomationId="WallpaperPicker" Grid.Column="1" Header="Duvar kağıdı"
                                          PlaceholderText="Duvar kağıdı seç" HorizontalAlignment="Stretch" />
                            </Grid>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button AutomationProperties.AutomationId="ApplyMonitorButton" AutomationProperties.Name="Uygula"
                                        Style="{StaticResource BrandAccentButtonStyle}" Click="ApplyMonitor_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE768;" FontSize="14" />
                                        <TextBlock Text="Uygula" />
                                    </StackPanel>
                                </Button>
                                <Button AutomationProperties.AutomationId="RemoveMonitorButton" AutomationProperties.Name="Monitörden kaldır"
                                        Style="{StaticResource SubtleButtonStyle}" Click="RemoveMonitor_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE74D;" FontSize="14" />
                                        <TextBlock Text="Kaldır" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Settings -->
                <StackPanel x:Name="SettingsPanel" Spacing="16" Visibility="Collapsed" MaxWidth="640">
                    <InfoBar x:Name="SettingsInfoBar" AutomationProperties.AutomationId="SettingsInfoBar" IsOpen="False" IsClosable="True" Severity="Success" />

                    <Border Style="{StaticResource SurfaceCardStyle}">
                        <StackPanel Spacing="16">
                            <TextBlock Text="Katalog" FontWeight="SemiBold" />
                            <TextBox x:Name="CatalogUrlBox" AutomationProperties.AutomationId="CatalogUrlBox" Header="Katalog URL"
                                     PlaceholderText="bundled veya http://localhost:8080/index.json"
                                     Description="bundled = uygulama ile gelen yerel katalog. HTTP(S) self-host adresi de girebilirsiniz." />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SurfaceCardStyle}">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Davranış" FontWeight="SemiBold" Margin="0,0,0,8" />
                            <ToggleSwitch x:Name="RunAtStartupSwitch" AutomationProperties.AutomationId="RunAtStartupSwitch" Header="Windows başlangıcında çalıştır"
                                          OnContent="Açık" OffContent="Kapalı" />
                            <ToggleSwitch x:Name="PauseFullscreenSwitch" AutomationProperties.AutomationId="PauseFullscreenSwitch" Header="Tam ekranda duraklat"
                                          OnContent="Açık" OffContent="Kapalı" IsOn="True" />
                        </StackPanel>
                    </Border>

                    <Button AutomationProperties.AutomationId="SaveSettingsButton" AutomationProperties.Name="Kaydet"
                            ToolTipService.ToolTip="Katalog adresini ve davranış ayarlarını kaydet (Ctrl+S)"
                            Style="{StaticResource BrandAccentButtonStyle}" Click="SaveSettings_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE74E;" FontSize="14" />
                            <TextBlock Text="Ayarları kaydet" />
                        </StackPanel>
                    </Button>

                    <Border Style="{StaticResource SurfaceCardStyle}">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Depolama" FontWeight="SemiBold" />
                            <TextBlock Opacity="0.65" FontSize="13" TextWrapping="WrapWholeWords"
                                       Text="İndirme önbelleği temizlendiğinde kurulu duvar kağıtları etkilenmez." />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button AutomationProperties.AutomationId="ClearCacheButton" AutomationProperties.Name="Önbelleği temizle"
                                        Style="{StaticResource SubtleButtonStyle}" Click="ClearCache_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE74D;" FontSize="14" />
                                        <TextBlock Text="Önbelleği temizle" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                </Grid>
            </ScrollViewer>
        </Grid>
    </NavigationView>
</Page>
