<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="CanliDuvarKagidi_Shell.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:CanliDuvarKagidi_Shell">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <Color x:Key="SystemAccentColor">#45B86A</Color>
                    <Color x:Key="SystemAccentColorDark1">#3DA35D</Color>
                    <Color x:Key="SystemAccentColorLight1">#58C97D</Color>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <Color x:Key="SystemAccentColor">#45B86A</Color>
                    <Color x:Key="SystemAccentColorDark1">#3DA35D</Color>
                    <Color x:Key="SystemAccentColorLight1">#58C97D</Color>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="Themes/AppStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
