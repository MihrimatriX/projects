<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Brand palette — docs/css/tokens.css (oklch yeşil accent) -->
    <Color x:Key="BrandPrimaryColor">#45B86A</Color>
    <Color x:Key="BrandSecondaryColor">#3DA35D</Color>
    <Color x:Key="BrandSurfaceColor">#12151A</Color>
    <Color x:Key="BrandCardBorderColor">#2A2F38</Color>
    <Color x:Key="BrandAccentTextColor">#0A120E</Color>

    <SolidColorBrush x:Key="BrandPrimaryBrush" Color="{StaticResource BrandPrimaryColor}" />
    <SolidColorBrush x:Key="BrandSecondaryBrush" Color="{StaticResource BrandSecondaryColor}" />
    <SolidColorBrush x:Key="BrandGradientStartBrush" Color="#45B86A" />
    <SolidColorBrush x:Key="BrandGradientEndBrush" Color="#3DA35D" />
    <SolidColorBrush x:Key="BrandAccentTextBrush" Color="{StaticResource BrandAccentTextColor}" />

    <LinearGradientBrush x:Key="BrandAccentGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#45B86A" Offset="0" />
        <GradientStop Color="#3DA35D" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="CardShimmerGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#1A45B86A" Offset="0" />
        <GradientStop Color="#1A3DA35D" Offset="1" />
    </LinearGradientBrush>

    <!-- Typography -->
    <Style x:Key="PageTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="-50" />
    </Style>

    <Style x:Key="PageSubtitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Opacity" Value="0.72" />
        <Setter Property="TextWrapping" Value="WrapWholeWords" />
        <Setter Property="MaxWidth" Value="640" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <Style x:Key="SectionLabelStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Opacity" Value="0.6" />
        <Setter Property="CharacterSpacing" Value="80" />
    </Style>

    <!-- Card container -->
    <Style x:Key="SurfaceCardStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <!-- Wallpaper / catalog tile -->
    <Style x:Key="WallpaperCardStyle" TargetType="Border">
        <Setter Property="Width" Value="220" />
        <Setter Property="Height" Value="184" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="Background" Value="{StaticResource CardShimmerGradient}" />
    </Style>

    <Style x:Key="BrandAccentButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Background" Value="{StaticResource BrandPrimaryBrush}" />
        <Setter Property="Foreground" Value="{StaticResource BrandAccentTextBrush}" />
    </Style>

    <Style x:Key="SubtleButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="CornerRadius" Value="8" />
    </Style>

    <!-- Type badge -->
    <Style x:Key="TypeBadgeStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="Background" Value="{ThemeResource LayerFillColorDefaultBrush}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <!-- Monitor card -->
    <Style x:Key="MonitorCardStyle" TargetType="Border">
        <Setter Property="MinWidth" Value="280" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <!-- Empty state -->
    <Style x:Key="EmptyStateTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="TextAlignment" Value="Center" />
    </Style>

    <Style x:Key="EmptyStateBodyStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Opacity" Value="0.65" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="WrapWholeWords" />
        <Setter Property="MaxWidth" Value="320" />
    </Style>

</ResourceDictionary>
