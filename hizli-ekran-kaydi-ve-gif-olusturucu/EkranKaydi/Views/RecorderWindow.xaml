<Window x:Class="EkranKaydi.Views.RecorderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ekran Kayıt Bölgesi"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        Loaded="Window_Loaded"
        KeyDown="Window_KeyDown">

    <Grid x:Name="RootGrid">
        <Canvas x:Name="OverlayCanvas" Background="Transparent">
            <Path x:Name="DimOverlayPath" Fill="#8C000000" IsHitTestVisible="True"
                  MouseLeftButtonDown="Overlay_MouseLeftButtonDown"
                  MouseMove="Overlay_MouseMove"
                  MouseLeftButtonUp="Overlay_MouseLeftButtonUp" />
        </Canvas>

        <Canvas x:Name="SelectionCanvas">
            <Rectangle x:Name="SelectionFrame" Stroke="{StaticResource AccentBrush}" StrokeThickness="2"
                       StrokeDashArray="4 3" Fill="#0FFF4444" Cursor="SizeAll"
                       MouseLeftButtonDown="Selection_MouseLeftButtonDown" />

            <Border Canvas.Left="0" Canvas.Top="0" x:Name="SizeLabelHost" Background="#BF000000" Padding="6,3" CornerRadius="4">
                <TextBlock x:Name="TxtSizeLabel" FontFamily="Consolas" FontSize="12" Foreground="White" />
            </Border>

            <TextBlock x:Name="TxtCursorBadge" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Text="İmleç: açık" />

            <Rectangle x:Name="HandleNw" Width="10" Height="10" Fill="{StaticResource AccentBrush}" Stroke="White" StrokeThickness="1" RadiusX="2" RadiusY="2"
                       Cursor="SizeNWSE" Tag="nw" MouseLeftButtonDown="Handle_MouseLeftButtonDown" />
            <Rectangle x:Name="HandleNe" Width="10" Height="10" Fill="{StaticResource AccentBrush}" Stroke="White" StrokeThickness="1" RadiusX="2" RadiusY="2"
                       Cursor="SizeNESW" Tag="ne" MouseLeftButtonDown="Handle_MouseLeftButtonDown" />
            <Rectangle x:Name="HandleSw" Width="10" Height="10" Fill="{StaticResource AccentBrush}" Stroke="White" StrokeThickness="1" RadiusX="2" RadiusY="2"
                       Cursor="SizeNESW" Tag="sw" MouseLeftButtonDown="Handle_MouseLeftButtonDown" />
            <Rectangle x:Name="HandleSe" Width="10" Height="10" Fill="{StaticResource AccentBrush}" Stroke="White" StrokeThickness="1" RadiusX="2" RadiusY="2"
                       Cursor="SizeNWSE" Tag="se" MouseLeftButtonDown="Handle_MouseLeftButtonDown" />
        </Canvas>

        <Border x:Name="HintBar" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,20,0,0"
                Background="{StaticResource BgFloatBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                Padding="16,8" CornerRadius="8">
            <TextBlock FontSize="12" Foreground="{StaticResource TextSecondaryBrush}">
                Sürükleyerek bölge seç · <Run FontFamily="Consolas" Foreground="{StaticResource TextPrimaryBrush}">Enter</Run> onayla ·
                <Run FontFamily="Consolas" Foreground="{StaticResource TextPrimaryBrush}">Esc</Run> iptal
            </TextBlock>
        </Border>

        <Border x:Name="SetupToolbar" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,24"
                Background="{StaticResource BgFloatBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                Padding="16,10" CornerRadius="8">
            <Border.Effect>
                <DropShadowEffect BlurRadius="32" ShadowDepth="8" Opacity="0.5" Color="Black" />
            </Border.Effect>
            <StackPanel Orientation="Horizontal">
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="FPS" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4" />
                    <ComboBox x:Name="CbFps" Style="{StaticResource ToolbarComboStyle}" SelectedIndex="1" Width="56">
                        <ComboBoxItem Content="10" />
                        <ComboBoxItem Content="15" />
                        <ComboBoxItem Content="24" />
                    </ComboBox>
                </StackPanel>
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="FORMAT" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4" />
                    <ComboBox x:Name="CbFormat" Style="{StaticResource ToolbarComboStyle}" SelectedIndex="0" Width="64">
                        <ComboBoxItem Content="GIF" />
                        <ComboBoxItem Content="MP4" />
                    </ComboBox>
                </StackPanel>
                <CheckBox x:Name="ChkCursor" IsChecked="True" Content="İmleci göster" VerticalAlignment="Bottom"
                          Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,12,4"
                          Checked="CursorToggle_Changed" Unchecked="CursorToggle_Changed" />
                <Button Content="İptal" Style="{StaticResource BtnGhost}" Click="Cancel_Click" Margin="0,0,8,0" VerticalAlignment="Bottom" />
                <Button Content="Kayda başla (R)" Style="{StaticResource BtnPrimary}" Click="StartRecord_Click" VerticalAlignment="Bottom" />
            </StackPanel>
        </Border>

        <Border x:Name="RecordFloatBar" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,24,0,0"
                Visibility="Collapsed" Height="52" Padding="20,12"
                Background="{StaticResource BgFloatBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                CornerRadius="26">
            <Border.Effect>
                <DropShadowEffect BlurRadius="32" ShadowDepth="8" Opacity="0.5" Color="Black" />
            </Border.Effect>
            <StackPanel Orientation="Horizontal">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                    <Grid Width="10" Height="10" Margin="0,0,8,0">
                        <Ellipse Width="10" Height="10" Fill="{StaticResource AccentBrush}" />
                        <Ellipse Width="18" Height="18" Stroke="{StaticResource AccentBrush}" StrokeThickness="2" Opacity="0.45">
                            <Ellipse.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1" CenterX="9" CenterY="9" />
                            </Ellipse.RenderTransform>
                            <Ellipse.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                             From="1" To="1.3" Duration="0:0:0.6" AutoReverse="True" />
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                             From="1" To="1.3" Duration="0:0:0.6" AutoReverse="True" />
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                             From="1" To="0.35" Duration="0:0:0.6" AutoReverse="True" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Ellipse.Triggers>
                        </Ellipse>
                    </Grid>
                    <TextBlock Text="REC" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
                </StackPanel>
                <TextBlock x:Name="TxtRecTime" Text="00:00:00" FontFamily="Consolas" FontSize="14" FontWeight="Medium"
                           Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" MinWidth="72" Margin="0,0,14,0" />
                <TextBlock x:Name="TxtRecMeta" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,14,0" />
                <Button x:Name="BtnStop" Width="32" Height="32" Click="StopRecord_Click" ToolTip="Kaydı durdur"
                        Background="{StaticResource AccentBrush}" BorderThickness="0" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                <Rectangle Width="12" Height="12" Fill="White" RadiusX="1" RadiusY="1" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{StaticResource AccentHoverBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Border>

        <TextBlock x:Name="ShortcutHint" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,20,20"
                   FontSize="11" Foreground="#59FFFFFF" Visibility="Collapsed">
            <Run FontFamily="Consolas" Background="#14FFFFFF" Text="Ctrl" />
            <Run Text="+" />
            <Run FontFamily="Consolas" Background="#14FFFFFF" Text="Alt" />
            <Run Text="+" />
            <Run FontFamily="Consolas" Background="#14FFFFFF" Text="R" />
            <Run Text=" durdur" />
        </TextBlock>
    </Grid>
</Window>
