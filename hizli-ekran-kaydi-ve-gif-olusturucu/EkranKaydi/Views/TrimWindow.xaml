<Window x:Class="EkranKaydi.Views.TrimWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:EkranKaydi.Controls"
        Title="Ekran Kaydı Önizleme ve Kırpma"
        Height="620" Width="920"
        MinHeight="520" MinWidth="700"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource ShellBrush}"
        WindowStyle="None"
        ResizeMode="CanResize"
        KeyDown="Window_KeyDown">

    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Background="{StaticResource BgAppBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{StaticResource BgToolbarBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="12,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="10" Height="10" Fill="#FFFF5F57" Margin="0,0,6,0" />
                        <Ellipse Width="10" Height="10" Fill="#FFFEBC2E" Margin="0,0,6,0" />
                        <Ellipse Width="10" Height="10" Fill="#FF28C840" />
                    </StackPanel>
                    <TextBlock Text="Ekran Kaydı Önizleme ve Kırpma" FontSize="12"
                               Foreground="{StaticResource TextMutedBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Button Content="×" Width="36" Height="28" Style="{StaticResource BtnGhost}" Padding="0"
                            FontSize="11" Click="Close_Click" HorizontalAlignment="Right" BorderThickness="0" Background="Transparent" />
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" MinHeight="200" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" x:Name="TxtMeta" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,12" />

                <Border Grid.Row="1" x:Name="PreviewBorder" Background="#FF0C0C0C" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="8" ClipToBounds="True" Margin="0,0,0,12">
                    <Grid>
                        <MediaElement x:Name="VideoPlayer" LoadedBehavior="Manual" UnloadedBehavior="Stop"
                                      Stretch="Uniform" MediaOpened="VideoPlayer_MediaOpened" />
                        <Button x:Name="BtnPlayOverlay" Style="{StaticResource PlayOverlayBtn}" Click="BtnPlayOverlay_Click"
                                HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Visible" />
                    </Grid>
                </Border>

                <Grid Grid.Row="2" Margin="0,0,0,12">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Oynat" Style="{StaticResource BtnSm}" Click="BtnPlay_Click" Margin="0,0,4,0" />
                        <Button Content="Duraklat" Style="{StaticResource BtnSm}" Click="BtnPause_Click" />
                    </StackPanel>
                    <TextBlock x:Name="TxtTimeDisplay" FontFamily="Consolas" FontSize="12"
                               Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>

                <Border Grid.Row="3" Background="{StaticResource BgTimelineBrush}" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <TextBlock x:Name="TxtTimelineHeader" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                            <TextBlock x:Name="TxtTrimInfo" FontSize="11" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Right" />
                        </Grid>
                        <controls:TrimTimeline x:Name="Timeline" TrimChanged="Timeline_TrimChanged" PlayheadChanged="Timeline_PlayheadChanged" />
                        <Grid Margin="0,6,0,0">
                            <TextBlock Text="0.0s" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                            <TextBlock x:Name="TxtMidLabel" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" />
                            <TextBlock x:Name="TxtEndLabel" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Right" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Grid.Row="4" x:Name="ExportPanel" Background="{StaticResource BgPanelBrush}" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="14,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <TextBlock Text="FORMAT" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4" />
                            <Border Background="{StaticResource BgFloatBrush}" BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="6" ClipToBounds="True">
                                <StackPanel Orientation="Horizontal">
                                    <ToggleButton x:Name="BtnFmtGif" Content="GIF" Style="{StaticResource SegmentBtn}" IsChecked="True" Click="Format_Click" Tag="GIF" BorderThickness="0" />
                                    <Border Width="1" Background="{StaticResource BorderBrush}" />
                                    <ToggleButton x:Name="BtnFmtMp4" Content="MP4" Style="{StaticResource SegmentBtn}" Click="Format_Click" Tag="MP4" BorderThickness="0" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="0,0,16,0">
                            <TextBlock Text="FPS" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4" />
                            <ComboBox x:Name="CbFps" Style="{StaticResource ToolbarComboStyle}" SelectedIndex="1" Width="72" SelectionChanged="CbFps_SelectionChanged">
                                <ComboBoxItem Content="10" />
                                <ComboBoxItem Content="15" />
                                <ComboBoxItem Content="24" />
                            </ComboBox>
                        </StackPanel>

                        <CheckBox x:Name="ChkCursor" Grid.Column="2" Content="İmleci dahil et" IsChecked="True"
                                  VerticalAlignment="Bottom" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,16,4" />

                        <StackPanel Grid.Column="3" VerticalAlignment="Bottom">
                            <TextBlock x:Name="TxtSizeEstimate" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                            <Border x:Name="WarnBanner" Background="#1FFBBF24" BorderBrush="#59FBBF24" BorderThickness="1"
                                    CornerRadius="6" Padding="8,6" Margin="0,6,0,0" Visibility="Collapsed">
                                <TextBlock Text="GIF boyutu 10 MB'ı aşabilir. MP4 önerilir." FontSize="12" Foreground="{StaticResource WarningBrush}" />
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Column="4" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                            <ProgressBar x:Name="ExportProgress" Height="4" Width="140" Margin="0,0,0,8" Visibility="Collapsed"
                                           Foreground="{StaticResource ExportBrush}" Background="#FF333333" Minimum="0" Maximum="100" />
                            <Button x:Name="BtnExport" Content="GIF Oluştur" Style="{StaticResource BtnExport}"
                                    Click="BtnExport_Click" Padding="22,10" FontWeight="SemiBold" MinWidth="140" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
