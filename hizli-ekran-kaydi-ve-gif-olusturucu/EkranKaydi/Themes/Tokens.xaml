<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- design/css/tokens.css -->
    <Color x:Key="BgAppColor">#FF121212</Color>
    <Color x:Key="BgFloatColor">#FF1E1E1E</Color>
    <Color x:Key="BgTimelineColor">#FF181818</Color>
    <Color x:Key="BgPanelColor">#FF1A1A1A</Color>
    <Color x:Key="BgToolbarColor">#FF1A1A1A</Color>
    <Color x:Key="BgHoverColor">#FF2A2A2A</Color>
    <Color x:Key="BgSelectedColor">#FF2D3748</Color>
    <Color x:Key="ShellColor">#FF0A0A0A</Color>
    <Color x:Key="AccentColor">#FFFF4444</Color>
    <Color x:Key="AccentHoverColor">#FFE03A3A</Color>
    <Color x:Key="AccentExportColor">#FF4ADE80</Color>
    <Color x:Key="AccentExportHoverColor">#FF22C55E</Color>
    <Color x:Key="TimelinePlayheadColor">#FF60A5FA</Color>
    <Color x:Key="TimelineRangeColor">#4060A5FA</Color>
    <Color x:Key="TextPrimaryColor">#FFFFFFFF</Color>
    <Color x:Key="TextSecondaryColor">#FFBBBBBB</Color>
    <Color x:Key="TextMutedColor">#FF777777</Color>
    <Color x:Key="BorderColor">#FF333333</Color>
    <Color x:Key="DangerColor">#FFEF4444</Color>
    <Color x:Key="SuccessColor">#FF22C55E</Color>
    <Color x:Key="WarningColor">#FFFBBF24</Color>

    <SolidColorBrush x:Key="BgAppBrush" Color="{StaticResource BgAppColor}" />
    <SolidColorBrush x:Key="BgFloatBrush" Color="{StaticResource BgFloatColor}" />
    <SolidColorBrush x:Key="BgTimelineBrush" Color="{StaticResource BgTimelineColor}" />
    <SolidColorBrush x:Key="BgPanelBrush" Color="{StaticResource BgPanelColor}" />
    <SolidColorBrush x:Key="BgToolbarBrush" Color="{StaticResource BgToolbarColor}" />
    <SolidColorBrush x:Key="BgHoverBrush" Color="{StaticResource BgHoverColor}" />
    <SolidColorBrush x:Key="BgSelectedBrush" Color="{StaticResource BgSelectedColor}" />
    <SolidColorBrush x:Key="ShellBrush" Color="{StaticResource ShellColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="ExportBrush" Color="{StaticResource AccentExportColor}" />
    <SolidColorBrush x:Key="ExportHoverBrush" Color="{StaticResource AccentExportHoverColor}" />
    <SolidColorBrush x:Key="TimelinePlayheadBrush" Color="{StaticResource TimelinePlayheadColor}" />
    <SolidColorBrush x:Key="TimelineRangeBrush" Color="{StaticResource TimelineRangeColor}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />

    <CornerRadius x:Key="RadiusSm">6</CornerRadius>
    <CornerRadius x:Key="RadiusMd">8</CornerRadius>
</ResourceDictionary>
