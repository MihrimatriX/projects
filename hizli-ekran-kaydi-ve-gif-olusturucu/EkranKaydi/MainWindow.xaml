<Window x:Class="EkranKaydi.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:EkranKaydi.ViewModels"
        xmlns:helpers="clr-namespace:EkranKaydi.Helpers"
        Title="Hızlı Ekran Kaydı ve GIF Oluşturucu"
        Height="640" Width="960"
        MinHeight="520" MinWidth="720"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource ShellBrush}"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowDrop="True" DragOver="Window_DragOver" Drop="Window_Drop">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.InputBindings>
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding ImportVideoCommand}" />
        <KeyBinding Key="C" Modifiers="Control" Command="{Binding CopyToClipboardCommand}" CommandParameter="{Binding SelectedRecording}" />
    </Window.InputBindings>

    <Window.Resources>
        <helpers:NullToVisibilityConverter x:Key="NullToVis" />
        <helpers:CountToVisibilityConverter x:Key="CountToVis" />
    </Window.Resources>

    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Background="{StaticResource BgAppBrush}" CornerRadius="10" ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="32" />
            </Grid.RowDefinitions>

            <!-- Titlebar -->
            <Border Grid.Row="0" Background="{StaticResource BgToolbarBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="12,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="10" Height="10" Fill="#FFFF5F57" Margin="0,0,6,0" />
                        <Ellipse Width="10" Height="10" Fill="#FFFEBC2E" Margin="0,0,6,0" />
                        <Ellipse Width="10" Height="10" Fill="#FF28C840" />
                    </StackPanel>
                    <TextBlock Text="Hızlı Ekran Kaydı ve GIF Oluşturucu" FontSize="12"
                               Foreground="{StaticResource TextMutedBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="—" Width="36" Height="28" Style="{StaticResource BtnGhost}" Padding="0"
                                FontSize="11" Click="Minimize_Click" BorderThickness="0" Background="Transparent" />
                        <Button Content="□" Width="36" Height="28" Style="{StaticResource BtnGhost}" Padding="0"
                                FontSize="11" Click="Maximize_Click" Margin="2,0" BorderThickness="0" Background="Transparent" />
                        <Button Content="×" Width="36" Height="28" Style="{StaticResource BtnGhost}" Padding="0"
                                FontSize="11" Click="Close_Click" BorderThickness="0" Background="Transparent" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Header -->
            <Border Grid.Row="1" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="20,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Ekran Kaydı" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                        <Border Margin="10,0,0,0" Padding="10,4" CornerRadius="12"
                                Background="{StaticResource BgFloatBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                            <TextBlock Text="Ctrl+Alt+R" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
                        </Border>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="Geçmişi temizle" Style="{StaticResource BtnGhost}" Command="{Binding ClearHistoryCommand}" Margin="0,0,8,0" />
                        <Button Content="Video aç…" Style="{StaticResource BtnGhost}" Command="{Binding ImportVideoCommand}" Margin="0,0,8,0"
                                ToolTip="Var olan bir videoyu GIF/MP4'e dönüştür (Ctrl+O veya pencereye sürükleyip bırakın)" />
                        <Button Content="Yeni kayıt" Style="{StaticResource BtnPrimary}" Command="{Binding StartNewRecordingCommand}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Body -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="280" />
                </Grid.ColumnDefinitions>

                <!-- History panel -->
                <Border Grid.Column="0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0" Padding="20,16,20,20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Son kayıtlar (10)" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,12" />

                        <!-- Empty history -->
                        <Border Grid.Row="1"
                                Visibility="{Binding RecordingCount, Converter={StaticResource CountToVis}, ConverterParameter=Inverse}"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6"
                                Background="{StaticResource BgFloatBrush}" MinHeight="160">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24">
                                <TextBlock Text="📹" FontSize="32" HorizontalAlignment="Center" Opacity="0.35" Margin="0,0,0,12" />
                                <TextBlock Text="Ctrl+Alt+R ile kayda başla" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"
                                           HorizontalAlignment="Center" TextAlignment="Center" />
                                <TextBlock Text="veya sağ üstten yeni kayıt oluştur; GIF'e çevirmek için bir videoyu buraya sürükleyin." FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                                           TextWrapping="Wrap" MaxWidth="320"
                                           HorizontalAlignment="Center" TextAlignment="Center" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>

                        <ListBox x:Name="RecordingsList" Grid.Row="1"
                                 ItemsSource="{Binding Recordings}"
                                 SelectedItem="{Binding SelectedRecording, Mode=TwoWay}"
                                 SelectionChanged="RecordingsList_SelectionChanged"
                                 MouseDoubleClick="RecordingsList_MouseDoubleClick"
                                 Style="{StaticResource ThumbListBoxStyle}"
                                 Visibility="{Binding RecordingCount, Converter={StaticResource CountToVis}}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="ThumbCard" Background="{StaticResource BgFloatBrush}"
                                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6"
                                            Cursor="Hand">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="68" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Border Grid.Row="0" ClipToBounds="True" CornerRadius="6,6,0,0">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                        <GradientStop Color="#FF2A3544" Offset="0" />
                                                        <GradientStop Color="#FF1A2332" Offset="1" />
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                                <Grid>
                                                    <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                                                    <TextBlock Text="{Binding ResolutionString}" FontFamily="Consolas" FontSize="10"
                                                               Foreground="#4DFFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               Visibility="{Binding Thumbnail, Converter={StaticResource NullToVis}, ConverterParameter=Inverse}" />
                                                </Grid>
                                            </Border>
                                            <StackPanel Grid.Row="1" Margin="8">
                                                <TextBlock Text="{Binding FormattedDate}" FontSize="11" FontWeight="Medium"
                                                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,2" />
                                                <TextBlock FontSize="10" Foreground="{StaticResource TextMutedBrush}" FontFamily="Consolas">
                                                    <Run Text="{Binding Type, Mode=OneWay}" />
                                                    <Run Text=" · " />
                                                    <Run Text="{Binding FormattedDuration, Mode=OneWay}" />
                                                </TextBlock>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                            <Setter TargetName="ThumbCard" Property="BorderBrush" Value="{StaticResource TimelinePlayheadBrush}" />
                                            <Setter TargetName="ThumbCard" Property="Background" Value="{StaticResource BgSelectedBrush}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                <!-- Detail panel -->
                <Grid Grid.Column="1" Margin="0">
                    <!-- Empty detail -->
                    <Border Padding="24"
                            Visibility="{Binding SelectedRecording, Converter={StaticResource NullToVis}, ConverterParameter=Inverse}">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Viewbox Width="40" Height="40" Margin="0,0,0,12" Opacity="0.35">
                                <Canvas Width="24" Height="24">
                                    <Rectangle Canvas.Left="2" Canvas.Top="4" Width="20" Height="14" RadiusX="2" RadiusY="2"
                                               Stroke="{StaticResource TextMutedBrush}" StrokeThickness="1.5" Fill="Transparent" />
                                    <Path Data="M10,9 L15,12 L10,15 Z" Fill="{StaticResource TextMutedBrush}" />
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="Ctrl+Alt+R ile kayda başla veya yeni kayıt oluştur."
                                       FontSize="13" Foreground="{StaticResource TextMutedBrush}" TextAlignment="Center"
                                       TextWrapping="Wrap" MaxWidth="220" LineHeight="20" />
                        </StackPanel>
                    </Border>

                    <!-- Selected detail — RelativeSource: DataContext çakışması yok -->
                    <Grid Margin="16,16,16,20"
                          Visibility="{Binding SelectedRecording, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource NullToVis}}"
                          DataContext="{Binding SelectedRecording, RelativeSource={RelativeSource AncestorType=Window}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="#FF0C0C0C" BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1" CornerRadius="8" Margin="0,0,0,12" MinHeight="120" MaxHeight="160">
                            <Grid>
                                <MediaElement x:Name="PreviewPlayer" LoadedBehavior="Manual" UnloadedBehavior="Stop"
                                              Stretch="Uniform" Margin="4" />
                                <Image x:Name="PreviewImage" Stretch="Uniform" Margin="4" Visibility="Collapsed" />
                            </Grid>
                        </Border>

                        <StackPanel Grid.Row="1" Margin="0,0,0,12">
                            <TextBlock Text="{Binding FormattedDate}" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8" />
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Format:" FontSize="12" Foreground="{StaticResource TextMutedBrush}" />
                                <TextBlock Grid.Column="1" Text="{Binding Type}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
                            </Grid>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Çözünürlük:" FontSize="12" Foreground="{StaticResource TextMutedBrush}" />
                                <TextBlock Grid.Column="1" Text="{Binding ResolutionString}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
                            </Grid>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Süre:" FontSize="12" Foreground="{StaticResource TextMutedBrush}" />
                                <TextBlock Grid.Column="1" Text="{Binding FormattedDuration}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Boyut:" FontSize="12" Foreground="{StaticResource TextMutedBrush}" />
                                <TextBlock Grid.Column="1" Text="{Binding FileSizeString}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
                            </Grid>
                        </StackPanel>

                        <StackPanel Grid.Row="2" VerticalAlignment="Bottom">
                            <Button Content="Trim editöründe aç" Style="{StaticResource BtnSm}" Margin="0,0,0,6" HorizontalAlignment="Stretch"
                                    Command="{Binding DataContext.OpenTrimEditorCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}" />
                            <Button Content="Panoya kopyala (Ctrl+C)" Style="{StaticResource BtnSm}" Margin="0,0,0,6" HorizontalAlignment="Stretch"
                                    Command="{Binding DataContext.CopyToClipboardCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}" />
                            <Button Content="Export klasörünü aç" Style="{StaticResource BtnSm}" Margin="0,0,0,6" HorizontalAlignment="Stretch"
                                    Command="{Binding DataContext.OpenExportFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                            <Button Content="Kaydı sil" Style="{StaticResource BtnDanger}" HorizontalAlignment="Stretch"
                                    Command="{Binding DataContext.DeleteRecordingCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>

            <!-- Status bar -->
            <Border Grid.Row="3" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="20,0">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="6" Height="6" Fill="{StaticResource SuccessBrush}" Margin="0,0,6,0" />
                        <TextBlock Text="{Binding StatusMessage}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                    </StackPanel>
                    <TextBlock Text="{Binding FfmpegStatus, StringFormat=v1.1 · {0}}" FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
