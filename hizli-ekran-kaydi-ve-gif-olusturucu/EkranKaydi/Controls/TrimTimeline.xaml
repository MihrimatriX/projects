<UserControl x:Class="EkranKaydi.Controls.TrimTimeline"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="64" MinHeight="64">
    <Grid>
        <Border x:Name="TrackBorder" Background="#FF222222" CornerRadius="6" ClipToBounds="True"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                MouseLeftButtonDown="Track_MouseLeftButtonDown" Cursor="Hand">
            <Canvas x:Name="TrackCanvas" ClipToBounds="True">
                <ItemsControl x:Name="ThumbStrip" Canvas.Left="0" Canvas.Top="0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#FF111111" BorderThickness="0,0,1,0">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#FF3A4556" Offset="0" />
                                        <GradientStop Color="#FF252D3A" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Rectangle x:Name="TrimRange" Fill="{StaticResource TimelineRangeBrush}"
                           Canvas.Top="0" Height="64" IsHitTestVisible="False" />

                <Rectangle x:Name="HandleStart" Width="8" Height="24" Fill="{StaticResource TimelinePlayheadBrush}"
                           RadiusX="3" RadiusY="3" Canvas.Top="20" Cursor="SizeWE"
                           MouseLeftButtonDown="HandleStart_MouseLeftButtonDown" />

                <Rectangle x:Name="HandleEnd" Width="8" Height="24" Fill="{StaticResource TimelinePlayheadBrush}"
                           RadiusX="3" RadiusY="3" Canvas.Top="20" Cursor="SizeWE"
                           MouseLeftButtonDown="HandleEnd_MouseLeftButtonDown" />

                <Rectangle x:Name="PlayheadMarker" Width="2" Height="64" Fill="{StaticResource TimelinePlayheadBrush}"
                           Canvas.Top="0" IsHitTestVisible="False" />
            </Canvas>
        </Border>
    </Grid>
</UserControl>
