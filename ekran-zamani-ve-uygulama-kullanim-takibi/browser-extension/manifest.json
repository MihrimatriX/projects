{
  "manifest_version": 3,
  "name": "Ekran Zamanı — Web Takibi",
  "version": "1.1.0",
  "minimum_chrome_version": "120",
  "description": "Site bazlı süreyi yerel Ekran Zamanı uygulamasına gönderir.",
  "permissions": ["tabs", "storage", "alarms", "idle"],
  "host_permissions": ["http://127.0.0.1/*"],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Ekran Zamanı Web Takibi",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  }
}
