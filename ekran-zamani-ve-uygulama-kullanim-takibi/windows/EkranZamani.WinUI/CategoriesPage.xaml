<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="EkranZamani_WinUI.CategoriesPage"
    x:Name="CategoriesRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource BgAppBrush}">

    <ScrollViewer Padding="24">
        <StackPanel Spacing="24" MaxWidth="960">
            <TextBlock Text="Kategori Kuralları" Style="{StaticResource PageTitleStyle}" />

            <Border Style="{StaticResource CardStyle}" Visibility="{Binding SuggestionsVisibility}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Önerilen kurallar" Style="{StaticResource CardTitleStyle}" />
                    <TextBlock Text="Son 7 günde sık kullanılan uygulamalar için otomatik kategori önerileri."
                               FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
                    <ListView ItemsSource="{Binding Suggestions}" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="8,6" ColumnDefinitions="*,120,Auto">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{Binding Pattern}" FontFamily="Consolas" FontSize="12"
                                                   Foreground="{StaticResource TextPrimaryBrush}" />
                                        <TextBlock Text="{Binding Reason}" FontSize="11"
                                                   Foreground="{StaticResource TextMutedBrush}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding CategoryLabel}" FontWeight="SemiBold"
                                               VerticalAlignment="Center" />
                                    <Button Grid.Column="2" Content="Uygula" Style="{StaticResource PrimaryButtonStyle}"
                                            Command="{Binding DataContext.ApplySuggestionCommand, ElementName=CategoriesRoot}"
                                            CommandParameter="{Binding}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,140,Auto" ColumnSpacing="8">
                        <TextBox PlaceholderText="desen (ör. devenv.exe)" Text="{Binding NewPattern, Mode=TwoWay}" />
                        <ComboBox Grid.Column="1" ItemsSource="{Binding CategoryOptions}"
                                  SelectedIndex="{Binding NewCategoryIndex, Mode=TwoWay}" />
                        <Button Grid.Column="2" Content="Ekle" Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding AddRuleCommand}" />
                    </Grid>
                    <Button Content="Varsayılan kuralları yükle" Style="{StaticResource SecondaryButtonStyle}"
                            HorizontalAlignment="Left" Command="{Binding ResetDefaultsCommand}" />

                    <ListView ItemsSource="{Binding Rules}" SelectionMode="None" MaxHeight="420">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="8,6" ColumnDefinitions="*,140,Auto">
                                    <TextBlock Text="{Binding Pattern}" FontFamily="Consolas" FontSize="12"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource TextSecondaryBrush}" />
                                    <ComboBox Grid.Column="1"
                                              ItemsSource="{Binding DataContext.CategoryOptions, ElementName=CategoriesRoot}"
                                              SelectedIndex="{Binding CategoryIndex, Mode=TwoWay}"
                                              SelectionChanged="Category_SelectionChanged" />
                                    <Button Grid.Column="2" Content="Sil" Style="{StaticResource SecondaryButtonStyle}"
                                            Command="{Binding DataContext.DeleteRuleCommand, ElementName=CategoriesRoot}"
                                            CommandParameter="{Binding}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>

            <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource CatProductiveBrush}" />
        </StackPanel>
    </ScrollViewer>
</Page>
