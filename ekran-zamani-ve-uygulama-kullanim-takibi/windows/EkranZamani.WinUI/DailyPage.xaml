<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="EkranZamani_WinUI.DailyPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource BgAppBrush}">

    <ScrollViewer Padding="24">
        <StackPanel Spacing="24" MaxWidth="960">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="8">
                    <TextBlock Text="Günlük Özet" Style="{StaticResource PageTitleStyle}" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button Content="←" Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding PreviousDayCommand}" />
                        <TextBlock Text="{Binding DateLabel}" FontSize="15" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}" />
                        <Button Content="→" Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding NextDayCommand}" />
                    </StackPanel>
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}" VerticalAlignment="Top">
                    <Button.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Text="CSV dışa aktar" Command="{Binding ExportCsvCommand}" />
                            <MenuFlyoutItem Text="JSON dışa aktar" Command="{Binding ExportJsonCommand}" />
                        </MenuFlyout>
                    </Button.Flyout>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE896;" FontSize="14" />
                        <TextBlock Text="Dışa Aktar" />
                    </StackPanel>
                </Button>
            </Grid>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="4">
                    <TextBlock Text="{Binding HeroTime}" FontSize="48" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="{Binding HeroMeta}" FontSize="13"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}" Visibility="{Binding TimelineVisibility}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Günün zaman çizelgesi" Style="{StaticResource CardTitleStyle}" />
                    <Grid ColumnDefinitions="*,*,*,*,*,*,*" Margin="0,0,0,6">
                        <TextBlock Text="00" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                        <TextBlock Grid.Column="1" Text="04" FontSize="11" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="08" FontSize="11" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" />
                        <TextBlock Grid.Column="3" Text="12" FontSize="11" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" />
                        <TextBlock Grid.Column="4" Text="16" FontSize="11" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" />
                        <TextBlock Grid.Column="5" Text="20" FontSize="11" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" />
                        <TextBlock Grid.Column="6" Text="24" FontSize="11" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Right" />
                    </Grid>
                    <Grid Height="56">
                        <Border Background="{StaticResource TimelineBgBrush}" CornerRadius="8" />
                        <!-- WinUI Style Setter'larinda Binding desteklenmez: Canvas.Left hic uygulanmiyor, tum
                             segmentler sola yigiliyordu. Ust uste binen Grid + bagli Margin ile konumlandirilir. -->
                        <Grid Height="48" Margin="0,4">
                            <ItemsControl ItemsSource="{Binding TimelineSegments}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Grid />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding Brush}" CornerRadius="4"
                                                HorizontalAlignment="Left" Margin="{Binding Offset}"
                                                Height="48" Width="{Binding WidthPx}"
                                                ToolTipService.ToolTip="{Binding ToolTip}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Border Width="10" Height="10" CornerRadius="2" Background="{StaticResource CatProductiveBrush}" />
                            <TextBlock Text="Verimli" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Border Width="10" Height="10" CornerRadius="2" Background="{StaticResource CatDistractingBrush}" />
                            <TextBlock Text="Dikkat dağıtıcı" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Border Width="10" Height="10" CornerRadius="2" Background="{StaticResource CatCommunicationBrush}" />
                            <TextBlock Text="İletişim" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Border Width="10" Height="10" CornerRadius="2" Background="{StaticResource CatNeutralBrush}" />
                            <TextBlock Text="Nötr" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Grid ColumnDefinitions="*,320" ColumnSpacing="24">
                <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="En çok kullanılan uygulamalar" Style="{StaticResource CardTitleStyle}" />
                        <ItemsControl ItemsSource="{Binding TopApps}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="8,6" ColumnDefinitions="Auto,Auto,*,120,52">
                                        <Border Grid.Column="0" Width="20" Height="20" CornerRadius="10"
                                                Background="{Binding RankBrush}" HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding RankLabel}" FontSize="11" FontWeight="SemiBold"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Foreground="{Binding RankForeground}" />
                                        </Border>
                                        <Border Grid.Column="1" Width="32" Height="32" CornerRadius="6" Margin="12,0,0,0"
                                                Background="{StaticResource BgHoverBrush}">
                                            <TextBlock Text="{Binding Initials}" FontSize="11" FontWeight="SemiBold"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Foreground="{StaticResource TextSecondaryBrush}" />
                                        </Border>
                                        <TextBlock Grid.Column="2" Text="{Binding DisplayName}" VerticalAlignment="Center"
                                                   FontWeight="Medium" TextTrimming="CharacterEllipsis"
                                                   Foreground="{StaticResource TextPrimaryBrush}" />
                                        <Border Grid.Column="3" Height="6" CornerRadius="3"
                                                Background="{StaticResource TimelineBgBrush}" VerticalAlignment="Center">
                                            <Border Background="{Binding BarBrush}" CornerRadius="3"
                                                    HorizontalAlignment="Left" Width="{Binding BarPixels}" />
                                        </Border>
                                        <TextBlock Grid.Column="4" Text="{Binding FormattedTime}"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                                   Foreground="{StaticResource TextSecondaryBrush}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Kategori dağılımı" Style="{StaticResource CardTitleStyle}" />
                        <ItemsControl ItemsSource="{Binding CategoryShares}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="Auto,*,36" Margin="0,0,0,12">
                                        <TextBlock Text="{Binding Label}" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                        <Border Grid.Column="1" Height="8" CornerRadius="4" Margin="10,0"
                                                Background="{StaticResource TimelineBgBrush}">
                                            <Border Background="{Binding Brush}" CornerRadius="4"
                                                    HorizontalAlignment="Left" Width="{Binding BarPixels}" />
                                        </Border>
                                        <TextBlock Grid.Column="2" Text="{Binding PercentText}"
                                                   Foreground="{StaticResource TextSecondaryBrush}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding IdleNote}" FontSize="12"
                                   Foreground="{StaticResource TextMutedBrush}" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource CardStyle}" Visibility="{Binding WebDomainsVisibility}">
                <StackPanel Spacing="8">
                    <TextBlock Text="Web siteleri (tarayıcı)" Style="{StaticResource CardTitleStyle}" />
                    <ItemsControl ItemsSource="{Binding WebDomains}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="4,6" ColumnDefinitions="*,120,52">
                                    <TextBlock Text="{Binding Domain}" FontFamily="Consolas" FontSize="12"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <Border Grid.Column="1" Height="6" CornerRadius="3"
                                            Background="{StaticResource TimelineBgBrush}" VerticalAlignment="Center">
                                        <Border Background="{StaticResource AccentBrush}" CornerRadius="3"
                                                HorizontalAlignment="Left" Width="{Binding BarPixels}" />
                                    </Border>
                                    <TextBlock Grid.Column="2" Text="{Binding FormattedTime}"
                                               HorizontalAlignment="Right" VerticalAlignment="Center"
                                               Foreground="{StaticResource TextSecondaryBrush}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <TextBlock Text="{Binding StatusText}" FontSize="11"
                       Foreground="{StaticResource TextMutedBrush}" />
        </StackPanel>
    </ScrollViewer>
</Page>
