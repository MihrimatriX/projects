<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="EkranZamani_WinUI.WeeklyPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource BgAppBrush}">

    <ScrollViewer Padding="24">
        <StackPanel Spacing="24" MaxWidth="960">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="4">
                    <TextBlock Text="Haftalık Özet" Style="{StaticResource PageTitleStyle}" />
                    <TextBlock Text="{Binding WeekRangeLabel}" FontSize="13"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}"
                        Content="HTML raporu aç" Command="{Binding OpenWeeklyReportCommand}" />
            </Grid>

            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Verimli gün serisi" FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding StreakText}" FontSize="32" FontWeight="Bold" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="16">
                    <TextBlock Text="Günlük bilgisayar süresi" Style="{StaticResource CardTitleStyle}" />
                    <ItemsControl ItemsSource="{Binding DailyBars}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Stretch" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Width="72" Spacing="8" VerticalAlignment="Bottom">
                                    <TextBlock Text="{Binding ValueText}" FontSize="11"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               HorizontalAlignment="Center" />
                                    <Border Height="{Binding BarHeight}" CornerRadius="6,6,2,2"
                                            Background="{StaticResource AccentBrush}" />
                                    <TextBlock Text="{Binding Label}" FontSize="11"
                                               HorizontalAlignment="Center"
                                               Foreground="{StaticResource TextMutedBrush}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                        <Border Background="{StaticResource BgAppBrush}" CornerRadius="12" Padding="16">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Haftalık ortalama" FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding AvgTotal}" FontSize="24" FontWeight="Bold" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Background="{StaticResource BgAppBrush}" CornerRadius="12" Padding="16">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Verimli süre ort." FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding AvgProductive}" FontSize="24" FontWeight="Bold" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Background="{StaticResource BgAppBrush}" CornerRadius="12" Padding="16">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Dikkat dağıtıcı ort." FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding AvgDistracting}" FontSize="24" FontWeight="Bold" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Bugün saatlik dağılım" Style="{StaticResource CardTitleStyle}" />
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding HourlyBars}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Bottom" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Width="28" Spacing="4" VerticalAlignment="Bottom"
                                                ToolTipService.ToolTip="{Binding ToolTip}">
                                        <Border Height="{Binding BarHeight}" CornerRadius="3,3,1,1"
                                                Background="{StaticResource CatProductiveBrush}" />
                                        <TextBlock Text="{Binding Label}" FontSize="9"
                                                   HorizontalAlignment="Center"
                                                   Foreground="{StaticResource TextMutedBrush}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Border>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="24">
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Kategori dağılımı (hafta)" Style="{StaticResource CardTitleStyle}" />
                        <ItemsControl ItemsSource="{Binding CategoryShares}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="Auto,*,36" Margin="0,0,0,12">
                                        <TextBlock Text="{Binding Label}" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="11" />
                                        <Border Grid.Column="1" Height="8" CornerRadius="4" Margin="10,0"
                                                Background="{StaticResource TimelineBgBrush}">
                                            <Border Background="{Binding Brush}" CornerRadius="4"
                                                    HorizontalAlignment="Left" Width="{Binding BarPixels}" />
                                        </Border>
                                        <TextBlock Grid.Column="2" Text="{Binding PercentText}"
                                                   Foreground="{StaticResource TextSecondaryBrush}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Haftalık notlar" Style="{StaticResource CardTitleStyle}" />
                        <ItemsControl ItemsSource="{Binding Insights}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,0,0,8"
                                               Foreground="{StaticResource TextSecondaryBrush}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

            <TextBlock Text="{Binding StatusMessage}" FontSize="11"
                       Foreground="{StaticResource TextMutedBrush}" />
        </StackPanel>
    </ScrollViewer>
</Page>
