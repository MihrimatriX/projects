<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="EkranZamani_WinUI.GoalsPage"
    x:Name="GoalsRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource BgAppBrush}">

    <ScrollViewer Padding="24">
        <StackPanel Spacing="24" MaxWidth="960">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="Odak Hedefleri" Style="{StaticResource PageTitleStyle}" />
                <Button Grid.Column="1" Content="Yeni hedef" Style="{StaticResource PrimaryButtonStyle}"
                        Click="ScrollToForm_Click" />
            </Grid>

            <ItemsControl ItemsSource="{Binding GoalRings}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsWrapGrid MaximumRowsOrColumns="3" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardStyle}" Width="220" Margin="0,0,16,16">
                            <StackPanel Spacing="8" HorizontalAlignment="Center">
                                <ProgressRing Value="{Binding Percentage}" Width="96" Height="96"
                                              Foreground="{StaticResource CatProductiveBrush}" />
                                <TextBlock Text="{Binding PercentText}" FontSize="24" FontWeight="Bold"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding StatusText}" FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           TextWrapping="Wrap" HorizontalAlignment="Center" />
                                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                    <Button Content="Düzenle" Style="{StaticResource SecondaryButtonStyle}"
                                            Command="{Binding DataContext.EditGoalCommand, ElementName=GoalsRoot}"
                                            CommandParameter="{Binding Progress}" />
                                    <Button Content="Sil" Style="{StaticResource SecondaryButtonStyle}"
                                            Command="{Binding DataContext.DeleteGoalCommand, ElementName=GoalsRoot}"
                                            CommandParameter="{Binding Progress}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border x:Name="GoalForm" Style="{StaticResource CardStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Text="Yeni / düzenle" Style="{StaticResource CardTitleStyle}" />
                    <TextBox PlaceholderText="Başlık" Text="{Binding NewTitle, Mode=TwoWay}" />
                    <Grid ColumnDefinitions="*,80,120" ColumnSpacing="8">
                        <TextBox PlaceholderText="desen" Text="{Binding NewPattern, Mode=TwoWay}" />
                        <TextBox Grid.Column="1" Text="{Binding NewTargetMinutes, Mode=TwoWay}" PlaceholderText="dk" />
                        <ComboBox Grid.Column="2" ItemsSource="{Binding CategoryOptions}"
                                  SelectedIndex="{Binding NewCategoryIndex, Mode=TwoWay}" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                        <Button Content="İptal" Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding CancelEditCommand}" />
                        <Button Content="{Binding FormButtonLabel}" Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding AddGoalCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource CatProductiveBrush}" />
        </StackPanel>
    </ScrollViewer>
</Page>
