<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="EkranZamani_WinUI.ShellPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource BgAppBrush}">

    <Grid ColumnDefinitions="240,*">
        <Border Grid.Column="0" Background="{StaticResource BgCardBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <Grid RowDefinitions="Auto,*,Auto">
                <Border Grid.Row="0" Padding="20,16"
                        BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE916;" Foreground="{StaticResource AccentBrush}" FontSize="20" />
                        <TextBlock Text="Ekran Zamanı" FontSize="15" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}" />
                    </StackPanel>
                </Border>

                <StackPanel x:Name="NavPanel" Grid.Row="1" Padding="8,12" Spacing="2">
                    <Button Tag="daily" Click="Nav_Click" Style="{StaticResource NavButtonActiveStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE787;" FontSize="16" />
                            <TextBlock Text="Günlük" />
                        </StackPanel>
                    </Button>
                    <Button Tag="weekly" Click="Nav_Click" Style="{StaticResource NavButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE9D2;" FontSize="16" />
                            <TextBlock Text="Haftalık" />
                        </StackPanel>
                    </Button>
                    <Button Tag="goals" Click="Nav_Click" Style="{StaticResource NavButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE735;" FontSize="16" />
                            <TextBlock Text="Odak Hedefleri" />
                        </StackPanel>
                    </Button>
                    <Button Tag="categories" Click="Nav_Click" Style="{StaticResource NavButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE8FD;" FontSize="16" />
                            <TextBlock Text="Kategoriler" />
                        </StackPanel>
                    </Button>
                    <Button Tag="settings" Click="Nav_Click" Style="{StaticResource NavButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE713;" FontSize="16" />
                            <TextBlock Text="Ayarlar" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <Border Grid.Row="2" Padding="16,12"
                        BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,1,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Ellipse x:Name="TrackingDot" Width="8" Height="8" Fill="{StaticResource SuccessBrush}" />
                        <TextBlock x:Name="TrackingStatusText" Text="İzleniyor" FontSize="12"
                                   Foreground="{StaticResource TextMutedBrush}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Frame x:Name="ContentFrame" Grid.Column="1" />
    </Grid>
</Page>
