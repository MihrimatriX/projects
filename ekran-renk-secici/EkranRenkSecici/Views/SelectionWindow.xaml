<Window x:Class="EkranRenkSecici.Views.SelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Renk seçimi"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        Cursor="Cross"
        MouseMove="Window_MouseMove"
        MouseDown="Window_MouseDown"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <Style x:Key="FormatTabStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource SubTextBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="4,6" />
            <Setter Property="BorderThickness" Value="0,0,0,2" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SegmentButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource SubTextBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="Padding" Value="6,5" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Canvas x:Name="MainCanvas">
        <Rectangle x:Name="DimOverlay" Fill="#26000000" />

        <Border x:Name="MagnifierBorder" Width="120" Height="120"
                BorderBrush="White" BorderThickness="2" CornerRadius="60"
                ClipToBounds="True" IsHitTestVisible="False">
            <Border.Effect>
                <DropShadowEffect BlurRadius="32" Opacity="0.4" ShadowDepth="0" Color="Black" />
            </Border.Effect>
            <Grid>
                <Image x:Name="ZoomImage" Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                <Rectangle x:Name="MagGrid" Opacity="0" IsHitTestVisible="False">
                    <Rectangle.Fill>
                        <DrawingBrush TileMode="Tile" Viewport="0,0,8,8" ViewportUnits="Absolute" Viewbox="0,0,8,8" ViewboxUnits="Absolute">
                            <DrawingBrush.Drawing>
                                <GeometryDrawing>
                                    <GeometryDrawing.Geometry>
                                        <GeometryGroup>
                                            <LineGeometry StartPoint="0,0" EndPoint="8,0" />
                                            <LineGeometry StartPoint="0,0" EndPoint="0,8" />
                                        </GeometryGroup>
                                    </GeometryDrawing.Geometry>
                                    <GeometryDrawing.Pen>
                                        <Pen Brush="#26FFFFFF" Thickness="1" />
                                    </GeometryDrawing.Pen>
                                </GeometryDrawing>
                            </DrawingBrush.Drawing>
                        </DrawingBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Rectangle Width="12" Height="1" Fill="White" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
                <Rectangle Width="1" Height="12" Fill="White" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
            </Grid>
        </Border>

        <Border x:Name="ColorPanel" Width="280" CornerRadius="12"
                Background="{StaticResource PanelOverlayBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                Padding="16" IsHitTestVisible="False">
            <Border.Effect>
                <DropShadowEffect BlurRadius="32" Opacity="0.35" ShadowDepth="0" Color="Black" />
            </Border.Effect>
            <StackPanel>
                <Border x:Name="SwatchTop" Height="64" CornerRadius="8"
                        BorderBrush="{StaticResource SwatchBorderBrush}" BorderThickness="1" Margin="0,0,0,12" />
                <TextBlock x:Name="ColorValueText" FontFamily="{StaticResource MonoFont}" FontSize="18"
                           FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"
                           HorizontalAlignment="Center" Margin="0,0,0,12" />

                <UniformGrid x:Name="FormatTabs" Rows="1" Columns="5" Margin="0,0,0,8">
                    <Button x:Name="TabHex" Content="HEX" Tag="0" Click="FormatTab_Click" Style="{StaticResource FormatTabStyle}" />
                    <Button x:Name="TabRgb" Content="RGB" Tag="1" Click="FormatTab_Click" Style="{StaticResource FormatTabStyle}" />
                    <Button x:Name="TabHsl" Content="HSL" Tag="2" Click="FormatTab_Click" Style="{StaticResource FormatTabStyle}" />
                    <Button x:Name="TabOklch" Content="OKLCH" Tag="3" Click="FormatTab_Click" Style="{StaticResource FormatTabStyle}" />
                    <Button x:Name="TabCss" Content="CSS" Tag="4" Click="FormatTab_Click" Style="{StaticResource FormatTabStyle}" />
                </UniformGrid>

                <TextBlock x:Name="MetaText" FontFamily="{StaticResource MonoFont}" FontSize="11"
                           Foreground="{StaticResource SubTextBrush}" HorizontalAlignment="Center" Margin="0,0,0,12" />

                <TextBlock Text="PİKSEL ORTALAMA" FontSize="11" FontWeight="SemiBold"
                           Foreground="{StaticResource MutedBrush}" Margin="0,0,0,8" />
                <Border Background="#0AFFFFFF" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        CornerRadius="8" Padding="3" Margin="0,0,0,12">
                    <UniformGrid Rows="1" Columns="3">
                        <Button x:Name="BtnSample1" Content="1×1" Tag="1" Click="SampleButton_Click" Style="{StaticResource SegmentButtonStyle}" />
                        <Button x:Name="BtnSample3" Content="3×3" Tag="3" Click="SampleButton_Click" Style="{StaticResource SegmentButtonStyle}" />
                        <Button x:Name="BtnSample5" Content="5×5" Tag="5" Click="SampleButton_Click" Style="{StaticResource SegmentButtonStyle}" />
                    </UniformGrid>
                </Border>

                <Rectangle Height="1" Fill="{StaticResource BorderBrush}" Margin="0,0,0,12" />

                <TextBlock Text="GEÇMİŞ" FontSize="11" FontWeight="SemiBold"
                           Foreground="{StaticResource MutedBrush}" Margin="0,0,0,8" HorizontalAlignment="Center" />
                <StackPanel x:Name="HistoryRow" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,4" />
            </StackPanel>
        </Border>

        <Border x:Name="HintBar" CornerRadius="8" Padding="12,8"
                Background="{StaticResource PanelOverlayBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                IsHitTestVisible="False">
            <TextBlock FontSize="11" Foreground="{StaticResource MutedBrush}" TextAlignment="Center"
                       Text="Tıkla kopyala · Enter kopyala · Tab format · Esc iptal · Space grid · 1/3/5 örnekleme" />
        </Border>
    </Canvas>
</Window>
