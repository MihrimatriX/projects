datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model Feed {
  id            String    @id @default(uuid())
  url           String    @unique
  title         String
  siteUrl       String?
  description   String?
  folder        String    @default("Genel")
  lastFetchedAt DateTime  @default(now())
  lastError     String?
  createdAt     DateTime  @default(now())
  articles      Article[]
}

model Article {
  id          String   @id @default(uuid())
  feedId      String
  feed        Feed     @relation(fields: [feedId], references: [id], onDelete: Cascade)
  guid        String   @unique
  title       String
  link        String
  author      String?
  content     String?
  snippet     String?
  publishedAt DateTime @default(now())
  isRead      Boolean  @default(false)
  isStarred   Boolean  @default(false)
  createdAt   DateTime @default(now())
}

// Uygulama durumu (or. varsayilan feedlerin bir kez eklendigi isareti)
model AppSetting {
  key   String @id
  value String
}
