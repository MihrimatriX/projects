{
  "name": "haber-akis-paneli-desktop",
  "productName": "Haber Akis Paneli",
  "version": "1.1.0",
  "description": "Haber Akis Paneli - masaustu kabugu",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "start": "electron ."
  },
  "devDependencies": {
    "electron": "^42.11.10",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "local.haber-akis-paneli",
    "productName": "Haber Akis Paneli",
    "executableName": "HaberAkisPaneli",
    "electronLanguages": ["tr", "en-US"],
    "directories": { "output": "out" },
    "files": ["main.cjs", "package.json"],
    "win": { "target": "dir", "icon": "../assets/app.ico" },
    "npmRebuild": false
  },
  "allowScripts": {
    "electron": true,
    "electron-winstaller": false
  }
}
