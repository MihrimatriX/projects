<UserControl x:Class="SistemYoneticisi.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:SistemYoneticisi.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:HomeViewModel}"
             d:DesignHeight="600" d:DesignWidth="780">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="20,12" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <TextBlock Text="Ana Sayfa" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                        <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Metrics.IsPaused}" Value="True">
                                            <Setter Property="Fill" Value="{StaticResource MutedTextBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock FontSize="12" Foreground="{StaticResource MutedTextBrush}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="Canlı izleme" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Metrics.IsPaused}" Value="True">
                                            <Setter Property="Text" Value="Duraklatıldı" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                    <Button Content="{Binding Metrics.PauseButtonText}" Command="{Binding Metrics.TogglePauseCommand}" Style="{StaticResource GhostButton}" />
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20,16">
            <StackPanel>
                <TextBlock Text="Gerçek OS metrikleri, modüler izleme ve telemetrisiz yerel kontrol. Bir modül seçin veya özet metriklerden devam edin."
                           TextWrapping="Wrap" Foreground="{StaticResource SubTextBrush}" FontSize="14" Margin="0,0,0,16" MaxWidth="520" />

                <Border Margin="0,0,0,16" Padding="10,12" CornerRadius="8"
                        Background="#1AF59E0B" BorderBrush="{StaticResource WarningBrush}" BorderThickness="1"
                        Visibility="{Binding Metrics.IsRamWarning, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="24" Height="24" CornerRadius="6" Background="#29F59E0B" Margin="0,0,12,0">
                            <TextBlock Text="!" FontWeight="Bold" Foreground="{StaticResource WarningBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Grid.Column="1" VerticalAlignment="Center" Foreground="{StaticResource SubTextBrush}" FontSize="12" TextWrapping="Wrap">
                            <Run Text="RAM uyarısı" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                            <Run Text="{Binding Metrics.RamText, Mode=OneWay}" />
                        </TextBlock>
                        <Button Grid.Column="2" Content="Dashboard" Style="{StaticResource GhostButton}" Command="{Binding OpenDashboardCommand}" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <UniformGrid Columns="4" Margin="0,0,0,20">
                    <Border Style="{StaticResource MetricCardBorder}" Margin="0,0,6,0">
                        <StackPanel>
                            <TextBlock Text="CPU" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" />
                            <TextBlock Text="{Binding Metrics.CpuPercentage, StringFormat={}{0}%}" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource AccentCpuBrush}" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Margin="3,0">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource MetricCardBorder}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Metrics.IsRamWarning}" Value="True">
                                        <Setter Property="BorderBrush" Value="{StaticResource WarningBrush}" />
                                        <Setter Property="BorderThickness" Value="2" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="RAM" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" />
                            <TextBlock Text="{Binding Metrics.RamPercentage, StringFormat={}{0}%}" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource AccentRamBrush}" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource MetricCardBorder}" Margin="3,0">
                        <StackPanel>
                            <TextBlock Text="DISK" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" />
                            <TextBlock Text="{Binding Metrics.PrimaryDiskUsage, StringFormat={}{0}%}" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource AccentDiskBrush}" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource MetricCardBorder}" Margin="6,0,0,0">
                        <StackPanel>
                            <TextBlock Text="AĞ" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" />
                            <TextBlock Text="{Binding Metrics.NetworkShortText}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource AccentNetBrush}" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <TextBlock Text="MODÜLLER" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,10" />
                <ItemsControl ItemsSource="{Binding Modules}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="2" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ModuleCardItem}">
                            <Button Margin="0,0,6,6" Command="{Binding DataContext.OpenModuleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding Id}" Cursor="Hand" HorizontalContentAlignment="Stretch" Background="Transparent" BorderThickness="0">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="card" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                                CornerRadius="10" Padding="16,14">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                                                    <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{StaticResource SubTextBrush}" TextWrapping="Wrap" Margin="0,3,0,8" />
                                                    <StackPanel Orientation="Horizontal">
                                                        <Border Padding="4,2" CornerRadius="4" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="0,0,6,0">
                                                            <TextBlock Text="Hazır" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}" />
                                                        </Border>
                                                        <Border Padding="4,2" CornerRadius="4" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                                            <TextBlock Text="{Binding ShortcutText, StringFormat={}{0}}" FontSize="10" Foreground="{StaticResource MutedTextBrush}" />
                                                        </Border>
                                                    </StackPanel>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="→" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" FontSize="15" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="card" Property="Background" Value="{StaticResource HoverBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="12,4">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Metrics.HistoryStatusText}" FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
