<Window x:Class="SistemYoneticisi.WelcomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hoş Geldiniz"
        Height="420" Width="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource PrimaryBrush}">

    <StackPanel Margin="28">
        <TextBlock Text="💻" FontSize="48" HorizontalAlignment="Center" />
        <TextBlock Text="Sistem Yöneticisi Paketi'ne Hoş Geldiniz"
                   FontSize="17" FontWeight="SemiBold"
                   Foreground="{StaticResource TextBrush}"
                   TextAlignment="Center" TextWrapping="Wrap"
                   Margin="0,12,0,12" />
        <TextBlock TextWrapping="Wrap" TextAlignment="Center"
                   Foreground="{StaticResource SubTextBrush}" Margin="0,0,0,16"
                   Text="CPU, RAM, disk, süreçler, servisler ve ağ bağlantılarını yerel olarak izleyin. Veriler cihazınızdan dışarı gönderilmez." />
        <Border Background="{StaticResource SecondaryBrush}" CornerRadius="8" Padding="14" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Hızlı ipuçları" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,8" />
                <TextBlock Foreground="{StaticResource SubTextBrush}" TextWrapping="Wrap"
                           Text="• 1–5 tuşları ile bölümler arasında geçin&#x0a;• Pencereyi kapatınca uygulama tepside kalır&#x0a;• Servis işlemleri için yönetici olarak çalıştırın&#x0a;• Ayarlar: Ctrl+," />
            </StackPanel>
        </Border>
        <CheckBox x:Name="RunAtLoginBox" Content="Windows açılışında otomatik başlat"
                  Foreground="{StaticResource TextBrush}" Margin="0,0,0,16" />
        <Button Content="Başla" Click="Start_Click" Style="{StaticResource PrimaryButton}"
                Padding="32,10" HorizontalAlignment="Center" />
    </StackPanel>
</Window>
