<Window x:Class="ClipboardYoneticisi.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ayarlar"
        Height="720" Width="460"
        MinHeight="420"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        Background="{StaticResource PrimaryBrush}">

    <!-- Kaydet/Iptal kaydirma alaninin disinda: kucuk ekran / yuksek DPI'da da gorunur. -->
    <DockPanel>
    <Border DockPanel.Dock="Bottom"
            Padding="20,12"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="0,1,0,0">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="CancelButton"
                    Content="İptal"
                    IsCancel="True"
                    Click="CancelButton_Click"
                    Padding="20,10"
                    Margin="0,0,10,0"
                    Background="{StaticResource SecondaryBrush}"
                    Foreground="{StaticResource TextBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    Cursor="Hand" />
            <Button x:Name="SaveButton"
                    Content="Kaydet"
                    IsDefault="True"
                    Click="SaveButton_Click"
                    Style="{StaticResource PrimaryButton}" />
        </StackPanel>
    </Border>
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
        <StackPanel>
            <TextBlock Text="Pano Yöneticisi Ayarları"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextBrush}"
                       Margin="0,0,0,20" />

            <TextBlock Text="Geçmiş limiti (öğe sayısı)"
                       Foreground="{StaticResource SubTextBrush}"
                       FontSize="12"
                       Margin="0,0,0,6" />
            <TextBox x:Name="HistoryLimitBox"
                     AutomationProperties.Name="Geçmiş limiti" Margin="0,0,0,16" />

            <TextBlock Text="Panel kısayolu (ör. Ctrl+Alt+V)"
                       Foreground="{StaticResource SubTextBrush}"
                       FontSize="12"
                       Margin="0,0,0,6" />
            <TextBox x:Name="ShowHotkeyBox"
                     AutomationProperties.Name="Panel kısayolu" Margin="0,0,0,12" />

            <TextBlock Text="Stack yapıştır kısayolu (ör. Ctrl+Alt+Shift+V)"
                       Foreground="{StaticResource SubTextBrush}"
                       FontSize="12"
                       Margin="0,0,0,6" />
            <TextBox x:Name="StackHotkeyBox"
                     AutomationProperties.Name="Stack yapıştır kısayolu" Margin="0,0,0,16" />

            <CheckBox x:Name="ExcludeSensitiveCheck"
                      Content="Hassas uygulamalardan kopyalamayı kaydetme"
                      Foreground="{StaticResource TextBrush}"
                      Margin="0,0,0,8" />
            <CheckBox x:Name="StartMinimizedCheck"
                      Content="Başlangıçta sistem tepsisine küçült"
                      Foreground="{StaticResource TextBrush}"
                      Margin="0,0,0,8" />
            <CheckBox x:Name="StartWithWindowsCheck"
                      Content="Windows ile birlikte başlat"
                      Foreground="{StaticResource TextBrush}"
                      Margin="0,0,0,8" />
            <CheckBox x:Name="AutoPasteCheck"
                      Content="Seçince otomatik Ctrl+V gönder (Ditto tarzı)"
                      Foreground="{StaticResource TextBrush}"
                      Margin="0,0,0,8" />
            <CheckBox x:Name="EnableTrayNotificationsCheck"
                      Content="Sistem tepsisi bildirimleri"
                      Foreground="{StaticResource TextBrush}"
                      Margin="0,0,0,8" />
            <CheckBox x:Name="NotifyOnCaptureCheck"
                      Content="Yeni kopyada bildirim göster"
                      Foreground="{StaticResource TextBrush}"
                      Margin="0,0,0,8" />
            <CheckBox x:Name="NotifyOnStackPasteCheck"
                      Content="Stack yapıştırmada bildirim göster"
                      Foreground="{StaticResource TextBrush}"
                      Margin="0,0,0,8" />
            <CheckBox x:Name="EnableOcrCheck"
                      Content="Görsel OCR (yerel Windows OCR)"
                      Foreground="{StaticResource TextBrush}"
                      Margin="0,0,0,8" />
            <CheckBox x:Name="EnableEncryptionCheck"
                      Content="Şifreli geçmiş modu (AES-256)"
                      Foreground="{StaticResource TextBrush}"
                      Margin="0,0,0,8" />
            <CheckBox x:Name="BlurSensitiveCheck"
                      Content="Hassas içerik önizlemesini bulanıklaştır"
                      Foreground="{StaticResource TextBrush}"
                      Margin="0,0,0,8" />
            <CheckBox x:Name="CheckForUpdatesCheck"
                      Content="Güncellemeleri otomatik kontrol et (günde bir)"
                      Foreground="{StaticResource TextBrush}"
                      Margin="0,0,0,16" />

            <TextBlock Text="Güncelleme feed URL (isteğe bağlı, boş = yalnızca yerel version.json)"
                       Foreground="{StaticResource SubTextBrush}"
                       FontSize="12"
                       Margin="0,0,0,6" />
            <TextBox x:Name="UpdateFeedUrlBox"
                     AutomationProperties.Name="Güncelleme feed URL" Margin="0,0,0,16" />

            <TextBlock Text="Otomatik silme (gün, 0 = kapalı)"
                       Foreground="{StaticResource SubTextBrush}"
                       FontSize="12"
                       Margin="0,0,0,6" />
            <TextBox x:Name="AutoDeleteDaysBox"
                     AutomationProperties.Name="Otomatik silme" Margin="0,0,0,16" />

            <TextBlock Text="Hariç tutulan uygulamalar (process adı, satır başına bir)"
                       Foreground="{StaticResource SubTextBrush}"
                       FontSize="12"
                       Margin="0,0,0,6" />
            <TextBox x:Name="ExcludedAppsBox"
                     AutomationProperties.Name="Hariç tutulan uygulamalar"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     Height="80"
                     Margin="0,0,0,16" />

            <TextBlock Text="Regex filtre (eşleşen içerik kaydedilmez, satır başına bir)"
                       Foreground="{StaticResource SubTextBrush}"
                       FontSize="12"
                       Margin="0,0,0,6" />
            <TextBox x:Name="RegexPatternsBox"
                     AutomationProperties.Name="Regex filtre"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     Height="80"
                     Margin="0,0,0,16" />

        </StackPanel>
    </ScrollViewer>
    </DockPanel>
</Window>
