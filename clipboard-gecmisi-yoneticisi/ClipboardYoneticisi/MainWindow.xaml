<Window x:Class="ClipboardYoneticisi.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:tb="http://www.hardcodet.net/taskbar"
        xmlns:helpers="clr-namespace:ClipboardYoneticisi.Helpers"
        mc:Ignorable="d"
        Title="Pano Geçmişi"
        Width="380"
        MinWidth="380"
        MaxWidth="380"
        Height="720"
        MinHeight="480"
        WindowStartupLocation="Manual"
        Topmost="True"
        ShowInTaskbar="False"
        FontFamily="{StaticResource UiFont}"
        Background="{StaticResource PrimaryBrush}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <helpers:StringNotEmptyToVisibilityConverter x:Key="StringNotEmptyToVis" />
        <helpers:StringEqualsConverter x:Key="StringEquals" />

        <Style x:Key="FilterChip" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource SecondaryBrush}" />
            <Setter Property="Foreground" Value="{StaticResource SubTextBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chip"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chip" Property="Background" Value="{StaticResource CardBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HistoryRow" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <!-- Ekran okuyucu / UIA sinif adi yerine onizleme metnini okusun. -->
            <Setter Property="AutomationProperties.Name" Value="{Binding PreviewText}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid MinHeight="44">
                            <Border x:Name="AccentBar"
                                    Width="3"
                                    HorizontalAlignment="Left"
                                    Background="Transparent" />
                            <Border x:Name="RowBg"
                                    Background="Transparent"
                                    Margin="3,0,0,0"
                                    Padding="13,10,16,10">
                                <ContentPresenter />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RowBg" Property="Background" Value="{StaticResource CardBrush}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                <Setter TargetName="AccentBar" Property="Background" Value="{StaticResource PinBrush}" />
                            </DataTrigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="RowBg" Property="Background" Value="{StaticResource SelectedBrush}" />
                                <Setter TargetName="AccentBar" Property="Background" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <ContextMenu x:Key="AppMenu"
                     AutomationProperties.Name="Uygulama menüsü"
                     Background="{StaticResource PrimaryBrush}"
                     Foreground="{StaticResource TextBrush}"
                     BorderBrush="{StaticResource BorderBrush}"
                     BorderThickness="1">
            <MenuItem Header="Geçmişi göster" Command="{Binding ShowMainWindowCommand}" />
            <MenuItem Header="Yedekle…" Command="{Binding ExportHistoryCommand}" />
            <MenuItem Header="İçe aktar…" Command="{Binding ImportHistoryCommand}" />
            <MenuItem Header="Ayarlar" Command="{Binding OpenSettingsCommand}" />
            <MenuItem Header="Yardım" Command="{Binding OpenHelpCommand}" InputGestureText="F1" />
            <MenuItem Header="Hakkında" Command="{Binding OpenAboutCommand}" />
            <Separator />
            <MenuItem Header="Oturumu kilitle"
                      Command="{Binding LockSessionCommand}"
                      Visibility="{Binding IsEncryptionEnabled, Converter={StaticResource BoolToVis}}" />
            <MenuItem Header="Geçmişi temizle" Command="{Binding ClearAllCommand}" />
            <MenuItem Header="Stack'i temizle" Command="{Binding ClearStackCommand}" />
            <Separator />
            <MenuItem Header="Çıkış" Command="{Binding ExitApplicationCommand}" />
        </ContextMenu>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Tepsi simgesi ve panel basligindaki menu dugmesi ayni menuyu (AppMenu) acar. -->
        <tb:TaskbarIcon x:Name="MyNotifyIcon"
                        ToolTipText="Pano Geçmişi Yöneticisi"
                        LeftClickCommand="{Binding ShowMainWindowCommand}"
                        NoLeftClickDelay="True"
                        DoubleClickCommand="{Binding ShowMainWindowCommand}"
                        ContextMenu="{StaticResource AppMenu}" />

        <!-- Header -->
        <Border Grid.Row="0"
                Padding="16,16,16,12"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <StackPanel>
                <DockPanel Margin="0,0,0,12">
                    <Button x:Name="MenuButton"
                            DockPanel.Dock="Right"
                            Content="⋯"
                            ToolTip="Menü: ayarlar, yedekleme, yardım"
                            AutomationProperties.Name="Menü"
                            Click="MenuButton_Click"
                            Style="{StaticResource FilterChip}"
                            Padding="10,0"
                            Margin="0"
                            FontSize="16" />
                    <TextBlock Text="Pano Geçmişi"
                               FontSize="15"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource TextBrush}" />
                </DockPanel>
                <Grid>
                    <TextBox x:Name="SearchBox"
                             AutomationProperties.Name="Geçmişte ara"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Height="36"
                             Padding="8,8,12,8" />
                    <TextBlock IsHitTestVisible="False"
                               Text="Geçmişte ara…"
                               Margin="12,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource SubTextBrush}"
                               FontSize="14">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Filters -->
        <Border Grid.Row="1"
                Margin="16,10,16,0"
                Padding="0,0,0,10"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
        <ItemsControl ItemsSource="{Binding FilterOptions}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Content="{Binding Label}"
                            Command="{Binding DataContext.SelectFilterCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding Key}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource FilterChip}">
                                <Style.Triggers>
                                    <DataTrigger Value="True">
                                        <DataTrigger.Binding>
                                            <MultiBinding Converter="{StaticResource StringEquals}">
                                                <Binding Path="DataContext.SelectedFilter" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                <Binding Path="Key" />
                                            </MultiBinding>
                                        </DataTrigger.Binding>
                                        <Setter Property="Background" Value="{StaticResource AccentMutedBrush}" />
                                        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        </Border>

        <!-- List -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="SABİTLENMİŞ"
                       FontSize="10"
                       FontWeight="Medium"
                       Foreground="{StaticResource SubTextBrush}"
                       Margin="16,8,16,4"
                       Visibility="{Binding HasPinnedItems, Converter={StaticResource BoolToVis}}" />

            <Border Grid.Row="1"
                    Background="{StaticResource SecondaryBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="16,8"
                    Visibility="{Binding HasMultiSelection, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <TextBlock Text="{Binding SelectedItemsCount, StringFormat={}{0} seçili}"
                               Foreground="{StaticResource TextBrush}"
                               FontSize="12"
                               VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                        <Button x:Name="MultiStackButton"
                                Content="Stack'e ekle"
                                Command="{Binding AddSelectedToStackCommand}"
                                Style="{StaticResource PrimaryButton}"
                                Padding="10,5"
                                Margin="0,0,8,0" />
                        <Button x:Name="MultiDeleteButton"
                                Content="Sil"
                                Command="{Binding DeleteSelectedItemsCommand}"
                                Background="{StaticResource DangerTextBrush}"
                                Foreground="{StaticResource PrimaryBrush}"
                                Padding="10,5"
                                BorderThickness="0"
                                Cursor="Hand" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- SelectedItem tek yonlu: iki yonlu baglama, gecikmeli geri yazimla hizli coklu secimi
                 (Shift+ok, Ctrl+tik) tek ogeye indiriyordu. Secim VM'e SelectionChanged ile bildirilir. -->
            <ListBox x:Name="HistoryList"
                     AutomationProperties.Name="Pano geçmişi"
                     Grid.Row="2"
                     ItemsSource="{Binding History}"
                     SelectedItem="{Binding SelectedItem, Mode=OneWay}"
                     Background="Transparent"
                     BorderThickness="0"
                     ItemContainerStyle="{StaticResource HistoryRow}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     MouseDoubleClick="ListBox_MouseDoubleClick"
                     KeyDown="ListBox_KeyDown"
                     SelectionChanged="HistoryList_SelectionChanged"
                     ContextMenuOpening="HistoryList_ContextMenuOpening"
                     SelectionMode="Extended">
                <ListBox.ContextMenu>
                    <ContextMenu x:Name="TransformMenu"
                                 Background="{StaticResource SecondaryBrush}"
                                 Foreground="{StaticResource TextBrush}"
                                 BorderBrush="{StaticResource BorderBrush}"
                                 BorderThickness="1" />
                </ListBox.ContextMenu>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Width="48"
                                    Height="48"
                                    CornerRadius="6"
                                    Margin="0,0,10,0"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    ClipToBounds="True"
                                    VerticalAlignment="Top">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsImage}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Image Source="{Binding ImagePreview}"
                                       Stretch="UniformToFill"
                                       RenderOptions.BitmapScalingMode="LowQuality" />
                            </Border>

                            <StackPanel Grid.Column="1" MinWidth="0">
                                <DockPanel Margin="0,0,0,4">
                                    <Border Background="{Binding BadgeBackground}"
                                            CornerRadius="4"
                                            Padding="6,2"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding BadgeLabel}"
                                                   FontSize="9"
                                                   FontWeight="SemiBold"
                                                   Foreground="{Binding BadgeForeground}" />
                                    </Border>
                                    <TextBlock Text="{Binding RelativeTime}"
                                               DockPanel.Dock="Right"
                                               FontSize="12"
                                               Foreground="{StaticResource SubTextBrush}"
                                               HorizontalAlignment="Right"
                                               Margin="8,0,20,0" />
                                </DockPanel>

                                <TextBlock Text="{Binding PreviewText}"
                                           FontFamily="{StaticResource MonoFont}"
                                           FontSize="12"
                                           Foreground="{StaticResource TextBrush}"
                                           TextWrapping="Wrap"
                                           MaxHeight="36"
                                           TextTrimming="CharacterEllipsis">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSensitiveHidden}" Value="True">
                                                    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
                                                    <Setter Property="Foreground" Value="{StaticResource SubTextBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>

                            <TextBlock Grid.Column="1"
                                       Text="📌"
                                       FontSize="11"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Top"
                                       Foreground="{StaticResource PinBrush}"
                                       Margin="0,0,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel Grid.Row="2"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        IsHitTestVisible="False">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding History.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Text="📋" FontSize="36" HorizontalAlignment="Center" Opacity="0.45" />
                <TextBlock x:Name="EmptyStateText"
                           Text="{Binding EmptyStateText}"
                           Foreground="{StaticResource SubTextBrush}"
                           FontSize="13"
                           Margin="0,12,0,0"
                           HorizontalAlignment="Center" />
            </StackPanel>

            <Border Grid.RowSpan="3"
                    Background="#D91E1E2E"
                    Visibility="{Binding IsLocked, Converter={StaticResource BoolToVis}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="🔒" FontSize="40" HorizontalAlignment="Center" />
                    <TextBlock Text="Oturum kilitli"
                               Foreground="{StaticResource TextBrush}"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Margin="0,12,0,12"
                               HorizontalAlignment="Center" />
                    <Button x:Name="UnlockButton"
                            Content="Kilidi aç"
                            Command="{Binding PromptUnlockCommand}"
                            Style="{StaticResource PrimaryButton}" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="3"
                Padding="16,10"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="{Binding HotkeyWarningText}"
                               FontSize="10"
                               Foreground="{StaticResource DangerTextBrush}"
                               Margin="0,0,0,2"
                               Visibility="{Binding HotkeyWarningText, Converter={StaticResource StringNotEmptyToVis}}" />
                    <TextBlock x:Name="StatusText"
                               Text="{Binding StatusText}"
                               FontSize="11"
                               Foreground="{StaticResource TextBrush}"
                               Margin="0,0,0,2"
                               Visibility="{Binding StatusText, Converter={StaticResource StringNotEmptyToVis}}" />
                    <TextBlock FontFamily="{StaticResource MonoFont}"
                               FontSize="10"
                               Foreground="{StaticResource SubTextBrush}"
                               TextWrapping="Wrap"
                               Text="↑↓ gezin · Enter panoya al · Ctrl+Z geri al · Esc kapat · F1 yardım" />
                </StackPanel>
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock x:Name="StackCountText"
                               Text="{Binding StackCount, StringFormat=Stack {0}}"
                               FontSize="11"
                               Foreground="{StaticResource SubTextBrush}"
                               Margin="0,0,10,0"
                               VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal"
                                Visibility="{Binding IsEncryptionEnabled, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="🔒"
                                   FontSize="12"
                                   Margin="0,0,4,0"
                                   Foreground="{StaticResource SuccessBrush}" />
                        <TextBlock Text="Şifreli"
                                   FontSize="12"
                                   Foreground="{StaticResource SuccessBrush}" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Copy confirmation -->
        <Border x:Name="CopyFlash"
                Grid.RowSpan="4"
                Background="#D91E1E2E"
                Visibility="Collapsed"
                IsHitTestVisible="False">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="✓"
                           FontSize="32"
                           Foreground="{StaticResource SuccessBrush}"
                           HorizontalAlignment="Center" />
                <TextBlock Text="Panoya alındı"
                           Foreground="{StaticResource SuccessBrush}"
                           FontSize="14"
                           Margin="0,8,0,0"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
