{
  "name": "takim-iletisim-ve-sohbet-araci",
  "version": "1.4.0",
  "private": true,
  "scripts": {
    "dev": "tsx server.ts",
    "build": "prisma generate && next build",
    "start": "tsx server.ts",
    "lint": "tsc --noEmit",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:setup": "prisma db push && tsx prisma/seed.ts",
    "db:postgres:push": "prisma db push --schema=prisma/schema.postgres.prisma",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "allowScripts": {
    "prisma": true,
    "@prisma/engines": true,
    "esbuild": true
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1146.0",
    "@prisma/adapter-libsql": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "cookie": "^2.0.1",
    "livekit-server-sdk": "^2.19.1",
    "next": "^16.3.8",
    "prisma": "^7.10.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "redis": "^6.3.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "postcss": "^8.5.29",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
