<Application x:Class="UygulamaBaslatici.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <Color x:Key="BgPaletteColor">#FA161618</Color>
        <Color x:Key="BgFooterColor">#FF18181A</Color>
        <Color x:Key="BgHoverColor">#FF2A2A2E</Color>
        <Color x:Key="BgSelectedColor">#FF3D3D8A</Color>
        <Color x:Key="BorderColor">#FF3A3A3E</Color>
        <Color x:Key="BorderSubtleColor">#FF2E2E32</Color>
        <Color x:Key="TextPrimaryColor">#FFFAFAFA</Color>
        <Color x:Key="TextSecondaryColor">#FFD4D4D8</Color>
        <Color x:Key="TextMutedColor">#FF71717A</Color>
        <Color x:Key="TextHintColor">#FF52525B</Color>
        <Color x:Key="AccentColor">#FF6366F1</Color>
        <Color x:Key="AccentShellColor">#FFF59E0B</Color>
        <Color x:Key="AccentWebColor">#FF3B82F6</Color>

        <SolidColorBrush x:Key="PaletteBrush" Color="{StaticResource BgPaletteColor}" />
        <SolidColorBrush x:Key="FooterBrush" Color="{StaticResource BgFooterColor}" />
        <SolidColorBrush x:Key="HoverBrush" Color="{StaticResource BgHoverColor}" />
        <SolidColorBrush x:Key="SelectedBrush" Color="{StaticResource BgSelectedColor}" />
        <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
        <SolidColorBrush x:Key="BorderSubtleBrush" Color="{StaticResource BorderSubtleColor}" />
        <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextPrimaryColor}" />
        <SolidColorBrush x:Key="SubTextBrush" Color="{StaticResource TextSecondaryColor}" />
        <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource TextMutedColor}" />
        <SolidColorBrush x:Key="HintBrush" Color="{StaticResource TextHintColor}" />
        <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
        <SolidColorBrush x:Key="ShellBrush" Color="{StaticResource AccentShellColor}" />
        <SolidColorBrush x:Key="WebBrush" Color="{StaticResource AccentWebColor}" />

        <FontFamily x:Key="BodyFont">Segoe UI</FontFamily>
        <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas, Courier New</FontFamily>

        <Style x:Key="GroupHeaderStyle" TargetType="TextBlock">
            <Setter Property="Padding" Value="20,8,20,4" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        </Style>
    </Application.Resources>
</Application>
