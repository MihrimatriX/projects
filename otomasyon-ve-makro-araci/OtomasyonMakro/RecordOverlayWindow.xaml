<Window x:Class="OtomasyonMakro.RecordOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:OtomasyonMakro.Helpers"
        Title="Kayıt"
        Height="40"
        WindowStyle="None" AllowsTransparency="False" ResizeMode="NoResize"
        Topmost="True" ShowInTaskbar="False"
        Left="0" Top="0"
        Background="{StaticResource RecordingBrush}">

    <Window.Resources>
        <helpers:BooleanToVisibilityConverter x:Key="BoolToVis" />
        <helpers:PauseLabelConverter x:Key="PauseLabelConverter" />
    </Window.Resources>

    <Border BorderBrush="#66EF4444" BorderThickness="0,0,0,1" Padding="16,0">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse Width="10" Height="10" Fill="{StaticResource DangerBrush}" Margin="0,0,10,0" />
                <TextBlock Text="{Binding StatusText}" FontSize="14" FontWeight="SemiBold" Margin="0,0,12,0" />
                <TextBlock Text="{Binding RecordTimeText}" FontFamily="{StaticResource MonoFont}"
                           FontSize="13" Foreground="{StaticResource AccentBrush}" />
            </StackPanel>

            <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="12"
                       Foreground="{StaticResource SubTextBrush}" Margin="0,0,16,0"
                       Text="Ctrl+Alt+M durdur · Esc iptal" />

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="{Binding IsRecordPaused, Converter={StaticResource PauseLabelConverter}}"
                        Command="{Binding ToggleRecordPauseCommand}" Style="{StaticResource BtnBase}" Height="28" Margin="0,0,8,0" />
                <Button Content="İptal" Command="{Binding StopRecordCommand}" Style="{StaticResource BtnBase}" Height="28" Margin="0,0,8,0" />
                <Button Content="Durdur ve kaydet" Command="{Binding StopRecordCommand}" Style="{StaticResource BtnDanger}" Height="28" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
