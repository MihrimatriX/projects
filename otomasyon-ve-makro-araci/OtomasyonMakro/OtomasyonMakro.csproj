<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <!-- Yalnızca daha yeni .NET runtime (ör. 10) kurulu makinelerde de çalışsın -->
    <RollForward>Major</RollForward>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>..\assets\app.ico</ApplicationIcon>
    <AssemblyName>OtomasyonMakro</AssemblyName>
    <RootNamespace>OtomasyonMakro</RootNamespace>
    <Version>2.0.0</Version>
    <AssemblyTitle>Otomasyon ve Makro Aracı</AssemblyTitle>
    <Product>Otomasyon ve Makro Aracı</Product>
    <Description>Windows masaüstü makro kayıt ve oynatma aracı</Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="OtomasyonMakro.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="FlaUI.UIA3" Version="5.0.0" />
    <PackageReference Include="InputSimulatorStandard" Version="1.0.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.13" />
    <PackageReference Include="NHotkey.Wpf" Version="4.0.0" />
  </ItemGroup>

</Project>
