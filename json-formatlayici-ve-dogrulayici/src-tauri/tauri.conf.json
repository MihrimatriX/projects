{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "JSON Formatlayıcı",
  "version": "1.3.0",
  "identifier": "com.jsonformatlayici.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3103",
    "beforeBuildCommand": "npm run build:static",
    "frontendDist": "../out"
  },
  "app": {
    "windows": [
      {
        "title": "JSON Formatlayıcı ve Doğrulayıcı",
        "width": 1280,
        "height": 800,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; worker-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png", "../assets/app.ico"]
  }
}
