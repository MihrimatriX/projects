{
  "name": "regex-test-ve-ogrenme-araci",
  "version": "1.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3105",
    "build": "next build",
    "build:static": "next build",
    "start": "next start -p 3105",
    "desktop": "npm run build:static && electron .",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@lezer/highlight": "^1.2.5",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "codemirror": "^6.0.2",
    "lz-string": "^1.5.0",
    "next": "^16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "regexp-tree": "^0.1.27",
    "typescript": "^7.0.2",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/lz-string": "^1.3.34",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "jsdom": "^30.1.2",
    "postcss": "^8.5.29",
    "rcedit": "^5.0.2",
    "tailwindcss": "^4.3.0",
    "vitest": "^5.0.3"
  },
  "main": "desktop/main.cjs",
  "build": {
    "appId": "com.portfolio.regex-test",
    "productName": "Regex Test ve Ogrenme",
    "electronLanguages": [
      "tr",
      "en-US"
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/**/*",
      "out/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "win": {
      "target": [
        "dir"
      ],
      "signAndEditExecutable": false
    }
  },
  "allowScripts": {
    "electron": true,
    "esbuild": true,
    "electron-winstaller": false
  }
}
