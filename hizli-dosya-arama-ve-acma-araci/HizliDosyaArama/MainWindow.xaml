<Window x:Class="HizliDosyaArama.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:helpers="clr-namespace:HizliDosyaArama.Helpers"
        Title="Hızlı Dosya Arama"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        WindowState="Maximized"
        KeyDown="Window_KeyDown"
        Deactivated="Window_Deactivated">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="AliasChipStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
            <Setter Property="Foreground" Value="{StaticResource AccentTextBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chip" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chip" Property="Background" Value="#4D3B82F6" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                <Setter TargetName="Chip" Property="Background" Value="{StaticResource AccentBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ResultItemStyle" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Row"
                                Padding="18,10"
                                BorderThickness="3,0,0,0"
                                BorderBrush="Transparent"
                                Background="Transparent"
                                SnapsToDevicePixels="True">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsRecent}" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{StaticResource BgRecentBrush}" />
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{StaticResource BgHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{StaticResource BgSelectedBrush}" />
                                <Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="True" />
                                    <Condition Property="IsMouseOver" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Row" Property="Background" Value="{StaticResource BgSelectedBrush}" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource BgOverlayBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="12*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   VerticalAlignment="Bottom"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,10"
                   FontSize="11"
                   Foreground="{StaticResource TextHintBrush}">
            <Run Text="Alt+F" FontFamily="{StaticResource MonoFont}" />
            <Run Text=" · Esc kapat" />
        </TextBlock>

        <Border Grid.Row="1"
                Width="560"
                MaxHeight="420"
                Background="{StaticResource BgBarBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="12"
                SnapsToDevicePixels="True">
            <Border.Effect>
                <DropShadowEffect BlurRadius="48" ShadowDepth="0" Color="Black" Opacity="0.5" />
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Search -->
                <Border Grid.Row="0" Padding="18,14" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Path Grid.Column="0" Width="18" Height="18" Margin="0,0,10,0" Stretch="Uniform"
                              Stroke="{StaticResource TextHintBrush}" StrokeThickness="1.75" Fill="Transparent"
                              Data="M11,11 m-7,0 a7,7 0 1,0 14,0 a7,7 0 1,0 -14,0 M20,20 L16.5,16.5" />

                        <TextBox x:Name="SearchBox"
                                 Grid.Column="1"
                                 Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="{StaticResource TextPrimaryBrush}"
                                 CaretBrush="{StaticResource AccentBrush}"
                                 FontSize="15"
                                 FontFamily="{StaticResource UiFont}"
                                 PreviewKeyDown="SearchBox_PreviewKeyDown">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="TextBox">
                                                <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                                              HorizontalScrollBarVisibility="Hidden"
                                                              VerticalScrollBarVisibility="Hidden" />
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </TextBox.Style>
                        </TextBox>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="6" Height="6" Margin="0,0,6,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsIndexing}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource WarningBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock FontSize="12" Foreground="{StaticResource TextMutedBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="{Binding IndexedCount, StringFormat={}{0:N0} dosya}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsIndexing}" Value="True">
                                                <Setter Property="Text" Value="İndeksleniyor…" />
                                                <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Aliases -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="18,8,18,10">
                    <TextBlock Text="ALIAS" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"
                               Margin="0,0,8,0" VerticalAlignment="Center" />
                    <ItemsControl ItemsSource="{Binding Aliases}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource AliasChipStyle}"
                                        Content="{Binding Name}"
                                        Command="{Binding DataContext.ApplyAliasCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Error banner -->
                <Border Grid.Row="2" Background="{StaticResource DangerSoftBrush}" Padding="18,8"
                        BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,0,1"
                        Visibility="{Binding ShowErrorBanner, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding ErrorMessage}" FontSize="12" Foreground="#FFB4B4" TextWrapping="Wrap" />
                </Border>

                <!-- Results -->
                <Grid Grid.Row="3" MinHeight="120">
                    <DockPanel LastChildFill="True">
                        <TextBlock DockPanel.Dock="Top"
                                   Text="{Binding GroupLabel}"
                                   Margin="18,8,18,4"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Background="{StaticResource BgRecentBrush}"
                                   Padding="0,0,0,4"
                                   Visibility="{Binding ShowResults, Converter={StaticResource BoolToVis}}" />

                        <ListBox x:Name="ResultsList"
                                 ItemsSource="{Binding Results}"
                                 SelectedItem="{Binding SelectedItem}"
                                 MaxHeight="260"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ItemContainerStyle="{StaticResource ResultItemStyle}"
                                 MouseDoubleClick="ResultsList_MouseDoubleClick"
                                 PreviewMouseLeftButtonDown="ResultsList_PreviewMouseLeftButtonDown">
                            <ListBox.Style>
                                <Style TargetType="ListBox">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ShowEmptyState}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.Style>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="32" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Width="32" Height="32" CornerRadius="4" VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#243B82F6" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IconKind}" Value="{x:Static helpers:FileIconKind.Code}">
                                                            <Setter Property="Background" Value="#2E94A3B8" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IconKind}" Value="{x:Static helpers:FileIconKind.Folder}">
                                                            <Setter Property="Background" Value="#29F59E0B" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IconKind}" Value="{x:Static helpers:FileIconKind.Config}">
                                                            <Setter Property="Background" Value="#2494A3B8" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="📄" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IconKind}" Value="{x:Static helpers:FileIconKind.Code}">
                                                                <Setter Property="Text" Value="&lt;/&gt;" />
                                                                <Setter Property="Foreground" Value="{StaticResource ExtensionBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IconKind}" Value="{x:Static helpers:FileIconKind.Folder}">
                                                                <Setter Property="Text" Value="📁" />
                                                                <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IconKind}" Value="{x:Static helpers:FileIconKind.Config}">
                                                                <Setter Property="Text" Value="⚙" />
                                                                <Setter Property="Foreground" Value="{StaticResource ExtensionBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IconKind}" Value="{x:Static helpers:FileIconKind.Doc}">
                                                                <Setter Property="Text" Value="📄" />
                                                                <Setter Property="Foreground" Value="{StaticResource AccentTextBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>

                                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding FileName}" FontSize="14" FontWeight="Medium"
                                                       Foreground="{StaticResource TextSecondaryBrush}" />
                                            <TextBlock Text="{Binding ShortPath}" FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding FilePath}" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="8,0,0,0">
                                            <TextBlock Text="{Binding ExtensionBadge}" FontFamily="{StaticResource MonoFont}"
                                                       FontSize="10" Foreground="{StaticResource ExtensionBrush}" HorizontalAlignment="Right" />
                                            <TextBlock Text="{Binding RelativeTime}" FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                                                       HorizontalAlignment="Right" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>

                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="32"
                                Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="🔍" FontSize="28" HorizontalAlignment="Center" Foreground="{StaticResource TextHintBrush}" />
                        <TextBlock Text="Dosya bulunamadı" FontSize="14" FontWeight="Medium" Foreground="{StaticResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center" Margin="0,8,0,0" />
                        <TextBlock Text="Arama terimini kısaltın veya indeksi yenileyin." FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                                   TextAlignment="Center" Margin="0,4,0,12" MaxWidth="280" TextWrapping="Wrap" />
                        <Button Content="İndeksi yenile" Command="{Binding StartIndexingCommand}"
                                Background="#1F3B82F6" Foreground="{StaticResource AccentTextBrush}"
                                BorderBrush="#6B3B82F6" BorderThickness="1" Padding="10,5" FontSize="12" FontWeight="SemiBold" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Footer -->
                <Border Grid.Row="4" Background="{StaticResource BgFooterBrush}" BorderBrush="{StaticResource BorderSubtleBrush}"
                        BorderThickness="0,1,0,0" Padding="18,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <TextBlock FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="{StaticResource TextHintBrush}">
                                <Run Text="Enter" FontWeight="SemiBold" />
                                <Run Text="{Binding FooterAction, Mode=OneWay}" Foreground="{StaticResource TextSecondaryBrush}" />
                            </TextBlock>
                            <TextBlock Text="Ctrl+Enter Klasör" FontFamily="{StaticResource MonoFont}" FontSize="11"
                                       Foreground="{StaticResource TextHintBrush}" Margin="12,0,0,0" />
                            <TextBlock Text="Shift+Enter Kopyala" FontFamily="{StaticResource MonoFont}" FontSize="11"
                                       Foreground="{StaticResource TextHintBrush}" Margin="12,0,0,0" />
                        </StackPanel>

                        <TextBlock Grid.Column="1" FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="{StaticResource TextHintBrush}">
                            <Run Text="{Binding SearchElapsedMs, Mode=OneWay}" />
                            <Run Text=" ms · " />
                            <Run Text="{Binding ResultCount, Mode=OneWay}" />
                            <Run Text=" sonuç" />
                        </TextBlock>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Toast -->
        <Border Grid.Row="2" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,72"
                Padding="16,10" CornerRadius="8"
                Background="{StaticResource BgBarBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                Visibility="{Binding ShowToast, Converter={StaticResource BoolToVis}}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="48" ShadowDepth="0" Color="Black" Opacity="0.5" />
            </Border.Effect>
            <StackPanel Orientation="Horizontal">
                <Ellipse Width="8" Height="8" Fill="{StaticResource SuccessBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                <TextBlock Text="{Binding ToastMessage}" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
