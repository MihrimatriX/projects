<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>..\assets\app.ico</ApplicationIcon>
    <AssemblyName>HizliDosyaArama</AssemblyName>
    <RootNamespace>HizliDosyaArama</RootNamespace>
    <!-- Makinede .NET 10 yoksa (yalnızca 10 varsa) da exe açılabilsin -->
    <RollForward>Major</RollForward>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="HizliDosyaArama.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\assets\app.ico" Link="assets\app.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.*" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.13" />
    <PackageReference Include="NHotkey.Wpf" Version="4.*" />
  </ItemGroup>

</Project>
