<Application x:Class="HizliDosyaArama.App"

             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

             StartupUri="MainWindow.xaml">

    <Application.Resources>

        <ResourceDictionary>

            <!-- design/mockup.html tokens -->

            <Color x:Key="BgBarColor">#FA1A1A1A</Color>

            <Color x:Key="BgHoverColor">#FF252525</Color>

            <Color x:Key="BgSelectedColor">#FF2D4A7A</Color>

            <Color x:Key="BgFooterColor">#FF1A1A1A</Color>

            <Color x:Key="BgRecentColor">#FF1F1F1F</Color>

            <Color x:Key="BgOverlayColor">#E00F0F0F</Color>

            <Color x:Key="AccentColor">#FF3B82F6</Color>

            <Color x:Key="AccentTextColor">#FF7BB1FF</Color>

            <Color x:Key="AccentSoftColor">#333B82F6</Color>

            <Color x:Key="TextPrimaryColor">#FFFFFFFF</Color>

            <Color x:Key="TextSecondaryColor">#FFCCCCCC</Color>

            <Color x:Key="TextMutedColor">#FF8A8A8A</Color>

            <Color x:Key="TextHintColor">#FF777777</Color>

            <Color x:Key="BorderColor">#FF333333</Color>

            <Color x:Key="BorderSubtleColor">#FF2A2A2A</Color>

            <Color x:Key="DangerColor">#FFEF4444</Color>

            <Color x:Key="DangerSoftColor">#24EF4444</Color>

            <Color x:Key="SuccessColor">#FF22C55E</Color>

            <Color x:Key="WarningColor">#FFF59E0B</Color>

            <Color x:Key="ExtensionColor">#FF94A3B8</Color>



            <SolidColorBrush x:Key="BgBarBrush" Color="{StaticResource BgBarColor}" />

            <SolidColorBrush x:Key="BgHoverBrush" Color="{StaticResource BgHoverColor}" />

            <SolidColorBrush x:Key="BgSelectedBrush" Color="{StaticResource BgSelectedColor}" />

            <SolidColorBrush x:Key="BgFooterBrush" Color="{StaticResource BgFooterColor}" />

            <SolidColorBrush x:Key="BgRecentBrush" Color="{StaticResource BgRecentColor}" />

            <SolidColorBrush x:Key="BgOverlayBrush" Color="{StaticResource BgOverlayColor}" />

            <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />

            <SolidColorBrush x:Key="AccentTextBrush" Color="{StaticResource AccentTextColor}" />

            <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource AccentSoftColor}" />

            <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />

            <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />

            <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />

            <SolidColorBrush x:Key="TextHintBrush" Color="{StaticResource TextHintColor}" />

            <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />

            <SolidColorBrush x:Key="BorderSubtleBrush" Color="{StaticResource BorderSubtleColor}" />

            <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />

            <SolidColorBrush x:Key="DangerSoftBrush" Color="{StaticResource DangerSoftColor}" />

            <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />

            <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />

            <SolidColorBrush x:Key="ExtensionBrush" Color="{StaticResource ExtensionColor}" />



            <FontFamily x:Key="UiFont">Segoe UI</FontFamily>

            <FontFamily x:Key="MonoFont">Consolas</FontFamily>



            <BooleanToVisibilityConverter x:Key="BoolToVis" />

        </ResourceDictionary>

    </Application.Resources>

</Application>

